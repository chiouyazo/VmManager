@page "/login"
@layout Components.Layout.LoginLayout
@attribute [AllowAnonymous]
@inject Components.Auth.BasicAuthStateProvider AuthState
@inject NavigationManager Navigation
@inject UserService UserService
@using VmManager.Agent.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage Storage

@if (_mustChangePassword)
{
    <MudCard Width="500px" Class="pa-5">
        <MudCardHeader>
            <MudText Typo="Typo.h5">Change Password</MudText>
        </MudCardHeader>
        <MudCardContent>
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                You must change your password before continuing.
            </MudAlert>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</MudAlert>
            }
            <MudTextField @bind-Value="_newPassword" Label="New Password"
                          InputType="InputType.Password" Immediate="true" Class="mb-4"
                          OnKeyDown="OnChangePasswordKeyDown" />
            <MudTextField @bind-Value="_confirmPassword" Label="Confirm Password"
                          InputType="InputType.Password" Immediate="true"
                          OnKeyDown="OnChangePasswordKeyDown" />
        </MudCardContent>
        <MudCardActions Class="px-4 pb-4">
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangePasswordAsync">
                Change Password
            </MudButton>
        </MudCardActions>
    </MudCard>
}
else
{
    <MudCard Width="500px" Class="pa-5">
        <MudCardHeader>
            <MudText Typo="Typo.h5">VmManager</MudText>
        </MudCardHeader>
        <MudCardContent>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</MudAlert>
            }
            <MudTextField @bind-Value="_username"
                          Label="Username"
                          Variant="Variant.Text"
                          Immediate="true"
                          Class="mb-4"
                          Disabled="_loading"
                          OnKeyDown="OnKeyDown" />
            <MudTextField @bind-Value="_password"
                          Label="Password"
                          Variant="Variant.Text"
                          InputType="InputType.Password"
                          Immediate="true"
                          Disabled="_loading"
                          OnKeyDown="OnKeyDown" />
        </MudCardContent>
        <MudCardActions Class="px-4 pb-4">
            <MudSpacer />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="LoginAsync"
                       Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Login
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    private string _username = "";
    private string _password = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _error = "";
    private bool _loading;
    private bool _initialized;
    private bool _mustChangePassword;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;

        try
        {
            ProtectedBrowserStorageResult<string> storedUser = await Storage.GetAsync<string>("auth_user");
            ProtectedBrowserStorageResult<string> storedPass = await Storage.GetAsync<string>("auth_pass");

            if (storedUser.Success && storedPass.Success
                && !string.IsNullOrEmpty(storedUser.Value)
                && !string.IsNullOrEmpty(storedPass.Value))
            {
                AuthState.RestoreSession(storedUser.Value, storedPass.Value);
                if (AuthState.MustChangePassword)
                {
                    _username = storedUser.Value;
                    _password = storedPass.Value;
                    _mustChangePassword = true;
                    StateHasChanged();
                }
                else
                {
                    Navigation.NavigateTo("/vms");
                }
            }
        }
        catch { }
    }

    private async Task LoginAsync()
    {
        _error = "";
        _loading = true;
        await Task.Yield();

        if (AuthState.TryLogin(_username, _password))
        {
            try
            {
                await Storage.SetAsync("auth_user", _username);
                await Storage.SetAsync("auth_pass", _password);
            }
            catch { }

            if (AuthState.MustChangePassword)
            {
                _mustChangePassword = true;
                _loading = false;
            }
            else
            {
                Navigation.NavigateTo("/vms");
            }
        }
        else
        {
            _error = "Invalid username or password";
            _loading = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _error = "";

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6)
        {
            _error = "Password must be at least 6 characters.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        try
        {
            UserService.ChangePassword(_username, _newPassword);
            AuthState.ClearMustChangePassword();

            try
            {
                await Storage.SetAsync("auth_pass", _newPassword);
            }
            catch { }

            Navigation.NavigateTo("/vms");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !_loading)
            await LoginAsync();
    }

    private async Task OnChangePasswordKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await ChangePasswordAsync();
    }
}
