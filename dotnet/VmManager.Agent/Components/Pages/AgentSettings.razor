@page "/agent-settings"
@using System.Security.Claims
@using VmManager.Agent.Services
@attribute [Authorize]
@inject SettingsService SettingsService
@inject BasicAuthStateProvider AuthState
@inject AuthorizationService AuthService
@inject EmailService EmailService
@inject IEnumerable<ICatalogAdapter> CatalogAdapters
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4">Agent Settings</MudText>

@if (!_canView)
{
    <MudAlert Severity="Severity.Warning">You do not have permission to view agent settings.</MudAlert>
}
else
{
    <MudStack Spacing="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Backend</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudSelect T="string" @bind-Value="_settings.VmBackend" Label="VM Backend">
                    <MudSelectItem Value="@("HyperV")">Hyper-V (Windows)</MudSelectItem>
                    <MudSelectItem Value="@("KVM")">KVM (Linux)</MudSelectItem>
                    <MudSelectItem Value="@("Proxmox")">Proxmox VE</MudSelectItem>
                </MudSelect>

                @if (_settings.VmBackend == "Proxmox")
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Proxmox API</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_proxmox.ApiUrl" Label="API URL" HelperText="e.g. https://192.168.1.100:8006" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_proxmox.Node" Label="Node Name" HelperText="Proxmox hostname" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_proxmox.ApiTokenId" Label="API Token ID" HelperText="user@realm!token-name" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_proxmox.ApiTokenSecret" Label="API Token Secret" InputType="InputType.Password" />
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Storage and Pool</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_proxmox.StorageId" Label="Storage ID" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_proxmox.PoolId" Label="Pool ID" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudCheckBox @bind-Value="_proxmox.VerifySsl" Label="Verify SSL" />
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Network</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_proxmox.DefaultBridge" Label="Default Bridge" HelperText="e.g. vmbr0, vmbr1" />
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">VM ID Range</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_proxmox.VmIdRangeStart" Label="Range Start" Min="100" HelperText="e.g. 400" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_proxmox.VmIdRangeEnd" Label="Range End" Min="100" HelperText="e.g. 499" />
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Pool Limits</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_proxmox.MaxPoolMemoryMb" Label="Max Pool Memory (MB)" Min="0" HelperText="0 = unlimited" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_proxmox.MaxPoolCpuCores" Label="Max Pool CPUs" Min="0" HelperText="0 = unlimited" />
                        </MudItem>
                    </MudGrid>
                }
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">VM Defaults</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_settings.LocalVmPath" Label="Local VM Storage Path" Class="mb-2" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudNumericField @bind-Value="_settings.DefaultMemoryMb" Label="Default Memory (MB)" Min="512" Step="512" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudNumericField @bind-Value="_settings.DefaultCpuCount" Label="Default CPUs" Min="1" Max="32" />
                    </MudItem>
                </MudGrid>
                <MudGrid Class="mt-2">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_settings.DefaultVmUsername" Label="VM Username" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_settings.DefaultVmPassword" Label="VM Password" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_settings.RdpDomainSuffix" Label="RDP Domain Suffix"
                                      HelperText="e.g. vms.domain.com" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Locale</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudCheckBox @bind-Value="_settings.ApplyLocaleOnCreate" Label="Apply locale on VM creation" Class="mb-2" />
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_selectedLocale" Label="Locale">
                            @foreach (string name in LocaleMap.Keys)
                            {
                                <MudSelectItem Value="@name">@name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_selectedKeyboard" Label="Keyboard Layout">
                            @foreach (string name in KeyboardMap.Keys)
                            {
                                <MudSelectItem Value="@name">@name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_selectedTimezone" Label="Timezone">
                            @foreach (string name in TimezoneMap.Keys)
                            {
                                <MudSelectItem Value="@name">@name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudCheckBox @bind-Value="_settings.RenameComputerToVmName" Label="Rename guest computer to VM name" Class="mt-2" />
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Scripts</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="_settings.PostCreationScript" Label="Post-Creation Script"
                              Lines="4" Variant="Variant.Outlined" Class="mb-4" />
                <MudTextField @bind-Value="_settings.PostStartupScript" Label="Post-Startup Script"
                              Lines="4" Variant="Variant.Outlined" />
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Email (SMTP)</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudCheckBox @bind-Value="_settings.SmtpEnabled" Label="Enable SMTP" Class="mb-2" />
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_settings.SmtpHost" Label="SMTP Host" Disabled="@(!_settings.SmtpEnabled)" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField @bind-Value="_settings.SmtpPort" Label="Port" Disabled="@(!_settings.SmtpEnabled)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_settings.SmtpUsername" Label="Username" Disabled="@(!_settings.SmtpEnabled)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_settings.SmtpPassword" Label="Password"
                                      InputType="InputType.Password" Disabled="@(!_settings.SmtpEnabled)" />
                    </MudItem>
                </MudGrid>
                <MudGrid Class="mt-2">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_settings.SmtpFromAddress" Label="From Address" Disabled="@(!_settings.SmtpEnabled)" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudCheckBox @bind-Value="_settings.SmtpUseTls" Label="Use TLS" Disabled="@(!_settings.SmtpEnabled)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_testEmailAddress" Label="Test Email To" Disabled="@(!_settings.SmtpEnabled)"
                                      Placeholder="recipient@example.com" />
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-end">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   Disabled="@(!_settings.SmtpEnabled || string.IsNullOrWhiteSpace(_testEmailAddress))"
                                   OnClick="TestEmail">
                            Send Test
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Resource Limits</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_settings.MaxTotalVms" Label="Max Total VMs (0 = unlimited)" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_settings.DefaultUserMaxVms" Label="Default User Max VMs" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_settings.StaleVmReminderDays" Label="Stale VM Reminder (days)" Min="0" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Monitoring</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudCheckBox @bind-Value="_monitoring.Enabled" Label="Enable monitoring" Class="mb-2" />
                <MudTextField @bind-Value="_monitoring.DefaultNotificationEmail" Label="Default notification email"
                              HelperText="Fallback email for checks without a specific address"
                              Disabled="@(!_monitoring.Enabled)" Class="mb-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Polling Intervals (seconds)</MudText>
                <MudGrid Class="mb-4">
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.VmStateIntervalSeconds" Label="VM State" Min="10" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.MetricsIntervalSeconds" Label="Metrics" Min="10" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.PortCheckIntervalSeconds" Label="Port Check" Min="10" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.HostHealthIntervalSeconds" Label="Host Health" Min="30" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Email Notifications (per check: toggle + optional email override)</MudText>
                @foreach (MonitoringCheckConfig check in _monitoringChecks)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudCheckBox T="bool" @bind-Value="check.Entry.Enabled" Disabled="@(!_monitoring.Enabled)" />
                        <MudText Typo="Typo.body2" Style="min-width: 200px;">@check.Label</MudText>
                        <MudTextField @bind-Value="check.Entry.Email" Placeholder="(default email)"
                                      Disabled="@(!_monitoring.Enabled || !check.Entry.Enabled)"
                                      Style="max-width: 300px;" />
                    </MudStack>
                }

                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Thresholds</MudText>
                <MudGrid>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.HostCpuPercentWarning" Label="CPU Warning %" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.HostCpuPercentCritical" Label="CPU Critical %" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.HostMemoryPercentWarning" Label="Memory Warning %" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.HostMemoryPercentCritical" Label="Memory Critical %" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.StorageFreePercentWarning" Label="Storage Free Warning %" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.StorageFreePercentCritical" Label="Storage Free Critical %" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.VmUptimeDaysWarning" Label="VM Uptime Days" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.SnapshotChainDepthWarning" Label="Snapshot Depth" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.FailedLoginThreshold" Label="Failed Login Threshold" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.BruteForceThreshold" Label="Brute Force Threshold" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.Thresholds.CertificateExpiryDaysWarning" Label="Cert Expiry Days" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudNumericField @bind-Value="_monitoring.AlertRetentionDays" Label="Alert Retention Days" Disabled="@(!_monitoring.Enabled)" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Image Feeds</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddFeed" Disabled="@(!_canManageFeeds)">
                    Add Feed
                </MudButton>
            </MudCardHeader>
            <MudCardContent>
                @if (_settings.Feeds.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No feeds configured. Add a feed to browse and import VM images.</MudText>
                }
                else
                {
                    @foreach (FeedConfiguration feed in _settings.Feeds)
                    {
                        <MudCard Elevation="0" Class="mb-3 pa-3" Style="border: 1px solid var(--mud-palette-lines-default);">
                            <MudGrid>
                                <MudItem xs="12" md="3">
                                    <MudTextField @bind-Value="feed.Name" Label="Name" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudSelect T="FeedType" @bind-Value="feed.Type" Label="Type">
                                        <MudSelectItem Value="FeedType.OCI">OCI Registry</MudSelectItem>
                                        <MudSelectItem Value="FeedType.Nexus">Nexus</MudSelectItem>
                                        <MudSelectItem Value="FeedType.Local">Local Path</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField @bind-Value="feed.Url" Label="@(feed.Type == FeedType.Local ? "Path" : "URL")" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    @if (_discoveredRepos.TryGetValue(feed, out List<string>? repos) && repos.Count > 0)
                                    {
                                        <MudSelect T="string" @bind-Value="feed.Repository" Label="Repository">
                                            @foreach (string repo in repos)
                                            {
                                                <MudSelectItem Value="@repo">@repo</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        <MudTextField @bind-Value="feed.Repository" Label="Repository" />
                                    }
                                </MudItem>
                            </MudGrid>
                            @if (feed.Type != FeedType.Local)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="12" md="3">
                                        <MudTextField @bind-Value="feed.Username" Label="Username" />
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudTextField @bind-Value="feed.Password" Label="Password" InputType="InputType.Password" />
                                    </MudItem>
                                </MudGrid>
                            }
                            <MudStack Row="true" Class="mt-2" Spacing="1">
                                @if (feed.Type != FeedType.Local)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               Disabled="@(string.IsNullOrWhiteSpace(feed.Url) || _feedTesting)"
                                               OnClick="() => TestFeed(feed)">
                                        Test Connection
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               Disabled="@(string.IsNullOrWhiteSpace(feed.Url) || _feedTesting)"
                                               OnClick="() => DiscoverRepos(feed)">
                                        Discover Repos
                                    </MudButton>
                                }
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="() => RemoveFeed(feed)" />
                            </MudStack>
                        </MudCard>
                    }
                }
            </MudCardContent>
        </MudCard>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettings"
                   StartIcon="@Icons.Material.Filled.Save" Class="align-self-end">
            Save Settings
        </MudButton>
    </MudStack>
}

@code {
    private AppSettings _settings = new AppSettings();
    private ProxmoxSettings _proxmox = new ProxmoxSettings();
    private MonitoringSettings _monitoring = new MonitoringSettings();
    private List<MonitoringCheckConfig> _monitoringChecks = new List<MonitoringCheckConfig>();
    private bool _canView;
    private bool _canManageFeeds;
    private bool _feedTesting;
    private Dictionary<FeedConfiguration, List<string>> _discoveredRepos = new Dictionary<FeedConfiguration, List<string>>();
    private string _testEmailAddress = "";
    private string _selectedLocale = "";
    private string _selectedKeyboard = "";
    private string _selectedTimezone = "";

    private sealed class MonitoringCheckConfig
    {
        public string Label { get; init; } = "";
        public MonitoringNotificationEntry Entry { get; init; } = new MonitoringNotificationEntry();
    }

    public static readonly Dictionary<string, string> LocaleMap = new Dictionary<string, string>
    {
        { "English (United States)", "en-US" },
        { "German (Germany)", "de-DE" },
        { "French (France)", "fr-FR" },
        { "Spanish (Spain)", "es-ES" },
        { "Italian (Italy)", "it-IT" },
        { "Dutch (Netherlands)", "nl-NL" },
        { "Portuguese (Brazil)", "pt-BR" },
        { "Polish (Poland)", "pl-PL" },
        { "Czech (Czech Republic)", "cs-CZ" },
        { "Swedish (Sweden)", "sv-SE" },
        { "Russian (Russia)", "ru-RU" },
        { "Turkish (Turkey)", "tr-TR" },
        { "Japanese (Japan)", "ja-JP" },
    };

    public static readonly Dictionary<string, string> KeyboardMap = new Dictionary<string, string>
    {
        { "US (QWERTY)", "00000409" },
        { "German (QWERTZ)", "00000407" },
        { "UK", "00000809" },
        { "French (AZERTY)", "0000040C" },
        { "Spanish", "0000040A" },
        { "Italian", "00000410" },
        { "Dutch", "00000413" },
        { "Swiss German", "00000807" },
        { "Polish", "00000415" },
        { "Czech", "00000405" },
        { "Swedish", "0000041D" },
        { "Russian", "00000419" },
        { "Turkish", "0000041F" },
    };

    public static readonly Dictionary<string, string> TimezoneMap = TimeZoneInfo
        .GetSystemTimeZones()
        .GroupBy(tz => tz.DisplayName)
        .ToDictionary(g => g.Key, g => g.First().Id);

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        ClaimsPrincipal user = state.User;
        _canView = AuthService.HasPermission(user, Permission.SettingsView);
        _canManageFeeds = AuthService.HasPermission(user, Permission.SettingsManageFeeds);

        if (_canView)
        {
            _settings = SettingsService.Load();
            _proxmox = _settings.Proxmox ?? new ProxmoxSettings();
            _monitoring = _settings.Monitoring ?? new MonitoringSettings();
            _selectedLocale = LocaleMap.FirstOrDefault(kv => kv.Value == _settings.DefaultLocale).Key ?? "";
            _selectedKeyboard = KeyboardMap.FirstOrDefault(kv => kv.Value == _settings.DefaultKeyboardLayout).Key ?? "";
            _selectedTimezone = TimezoneMap.FirstOrDefault(kv => kv.Value == _settings.DefaultTimezone).Key ?? "";
            BuildMonitoringChecks();
        }
    }

    private void SaveSettings()
    {
        try
        {
            if (!string.IsNullOrEmpty(_selectedLocale) && LocaleMap.TryGetValue(_selectedLocale, out string? localeId))
                _settings.DefaultLocale = localeId;
            if (!string.IsNullOrEmpty(_selectedKeyboard) && KeyboardMap.TryGetValue(_selectedKeyboard, out string? keyboardId))
                _settings.DefaultKeyboardLayout = keyboardId;
            if (!string.IsNullOrEmpty(_selectedTimezone) && TimezoneMap.TryGetValue(_selectedTimezone, out string? timezoneId))
                _settings.DefaultTimezone = timezoneId;

            foreach (FeedConfiguration feed in _settings.Feeds)
                feed.EnsureId();

            if (_settings.VmBackend == "Proxmox")
                _settings.Proxmox = _proxmox;
            _settings.Monitoring = _monitoring;
            SettingsService.Save(_settings);
            Snackbar.Add("Settings saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to save: " + ex.Message, Severity.Error);
        }
    }

    private void BuildMonitoringChecks()
    {
        _monitoringChecks = new List<MonitoringCheckConfig>
        {
            new MonitoringCheckConfig { Label = "VM Crash", Entry = _monitoring.VmCrash },
            new MonitoringCheckConfig { Label = "VM Stuck State", Entry = _monitoring.VmStuckState },
            new MonitoringCheckConfig { Label = "RDP Unreachable", Entry = _monitoring.RdpUnreachable },
            new MonitoringCheckConfig { Label = "WinRM Unreachable", Entry = _monitoring.WinRmUnreachable },
            new MonitoringCheckConfig { Label = "VM Uptime Exceeded", Entry = _monitoring.VmUptimeExceeded },
            new MonitoringCheckConfig { Label = "Snapshot Chain Deep", Entry = _monitoring.SnapshotChainDeep },
            new MonitoringCheckConfig { Label = "Failed Login", Entry = _monitoring.FailedLogin },
            new MonitoringCheckConfig { Label = "Brute Force Detected", Entry = _monitoring.BruteForceDetected },
            new MonitoringCheckConfig { Label = "Host CPU High", Entry = _monitoring.HostCpuHigh },
            new MonitoringCheckConfig { Label = "Host Memory High", Entry = _monitoring.HostMemoryHigh },
            new MonitoringCheckConfig { Label = "Storage Low", Entry = _monitoring.StorageLow },
            new MonitoringCheckConfig { Label = "Disk SMART Warning", Entry = _monitoring.DiskSmartWarning },
            new MonitoringCheckConfig { Label = "Agent Unhealthy", Entry = _monitoring.AgentUnhealthy },
            new MonitoringCheckConfig { Label = "Certificate Expiring", Entry = _monitoring.CertificateExpiring },
            new MonitoringCheckConfig { Label = "Quota Approaching", Entry = _monitoring.QuotaApproaching },
            new MonitoringCheckConfig { Label = "Capacity Near Limit", Entry = _monitoring.CapacityNearLimit },
        };
    }

    private void AddFeed()
    {
        _settings.Feeds.Add(new FeedConfiguration { Name = "New Feed" });
    }

    private void RemoveFeed(FeedConfiguration feed)
    {
        _settings.Feeds.Remove(feed);
        _discoveredRepos.Remove(feed);
    }

    private async Task TestFeed(FeedConfiguration feed)
    {
        _feedTesting = true;
        try
        {
            ICatalogAdapter? adapter = CatalogAdapters.FirstOrDefault(a => a.SupportedType == feed.Type);
            if (adapter == null)
            {
                Snackbar.Add("No adapter for feed type: " + feed.Type, Severity.Error);
                return;
            }

            bool success = await adapter.TestConnectivityAsync(feed);
            if (success)
                Snackbar.Add("Connection successful", Severity.Success);
            else
                Snackbar.Add("Connection failed", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Connection failed: " + ex.Message, Severity.Error);
        }
        finally
        {
            _feedTesting = false;
        }
    }

    private async Task DiscoverRepos(FeedConfiguration feed)
    {
        _feedTesting = true;
        try
        {
            ICatalogAdapter? adapter = CatalogAdapters.FirstOrDefault(a => a.SupportedType == feed.Type);
            if (adapter == null)
            {
                Snackbar.Add("No adapter for feed type: " + feed.Type, Severity.Error);
                return;
            }

            List<string> repos = await adapter.DiscoverRepositoriesAsync(feed);
            if (repos.Count == 0)
            {
                Snackbar.Add("No repositories found", Severity.Warning);
                return;
            }

            _discoveredRepos[feed] = repos;
            Snackbar.Add("Found " + repos.Count + " repositories", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Discovery failed: " + ex.Message, Severity.Error);
        }
        finally
        {
            _feedTesting = false;
        }
    }

    private async Task TestEmail()
    {
        try
        {
            EmailTestResult result = await EmailService.TestAsync(
                _testEmailAddress,
                _settings.SmtpHost,
                _settings.SmtpPort,
                _settings.SmtpUsername ?? "",
                _settings.SmtpPassword ?? "",
                _settings.SmtpFromAddress ?? "",
                _settings.SmtpUseTls);

            if (result.Success)
                Snackbar.Add("Test email sent", Severity.Success);
            else
                Snackbar.Add("Email failed: " + result.Error, Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Email failed: " + ex.Message, Severity.Error);
        }
    }
}
