@using VmManager.Agent.Services

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @Description
        </MudText>
        <MudTextField @bind-Value="_vmUsername" Label="VM Username"
                      HelperText="e.g. Administrator or DOMAIN\user" Class="mb-2" />
        <MudTextField @bind-Value="_vmPassword" Label="VM Password"
                      InputType="InputType.Password" Class="mb-2"
                      Placeholder="@(HasExisting ? "********" : "")"
                      HelperText="@(HasExisting ? "Leave empty to keep current password" : "")" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        @if (HasExisting)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="Clear">Clear Credentials</MudButton>
        }
        <MudButton Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _vmUsername = "";
    private string _vmPassword = "";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string CurrentVmUsername { get; set; } = "";

    [Parameter]
    public bool HasExisting { get; set; }

    [Parameter]
    public string Description { get; set; } = "Set Windows login credentials.";

    protected override void OnInitialized()
    {
        _vmUsername = CurrentVmUsername;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Clear()
    {
        MudDialog.Close(DialogResult.Ok(("", "")));
    }

    private void Save()
    {
        MudDialog.Close(DialogResult.Ok((_vmUsername.Trim(), _vmPassword)));
    }
}
