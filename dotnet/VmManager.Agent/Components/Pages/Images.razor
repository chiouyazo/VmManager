@page "/images"
@using System.Security.Claims
@using VmManager.Agent.Services
@attribute [Authorize]
@inject CatalogAggregator CatalogAggregator
@inject IVmBackend VmBackend
@inject SettingsService SettingsService
@inject ILocalImageMetadataService LocalImageService
@inject BasicAuthStateProvider AuthState
@inject AuthorizationService AuthService
@inject IDialogService DialogService
@inject ImportService ImportService
@inject ISnackbar Snackbar
@inject IBackgroundTaskManager TaskManager
@inject VmOwnershipService OwnershipService
@inject IVmTrackingService TrackingService
@inject QuotaService QuotaService

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Images</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_searchQuery" Placeholder="Search images..."
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" DebounceInterval="300" Class="mt-0" Style="max-width: 300px;" />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAll" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    @if (_localImages.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mb-2 mt-4">Local Images</MudText>
        <MudGrid Class="mb-6">
            @foreach (LocalImage local in _localImages)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1" Style="font-weight: 600;">@local.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @local.SizeGb.ToString("F1") GB | Extracted @local.ExtractedAt.ToString("yyyy-MM-dd")
                                </MudText>
                            </MudStack>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="() => CreateVmFromLocal(local)"
                                       Disabled="@(!_canImport)">
                                Create VM
                            </MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                           Color="Color.Error" Class="ml-1"
                                           Disabled="@(!_canDeleteLocal)"
                                           OnClick="() => DeleteLocalImage(local)" />
                        </MudCardHeader>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @if (_images.Count == 0 && _localImages.Count == 0)
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
            <MudText Typo="Typo.h6" Color="Color.Secondary">No images available</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Configure image feeds in Agent Settings to browse and import VM images.</MudText>
        </div>
    }

    @if (_images.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mb-2">Catalog</MudText>
        <MudGrid>
            @foreach (VmImage image in FilteredImages)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1" Style="font-weight: 600;">@image.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@image.SourceLabel</MudText>
                            </MudStack>
                            <MudSpacer />
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@image.ImageType</MudChip>
                        </MudCardHeader>
                        <MudCardContent Class="pt-0">
                            @if (!string.IsNullOrEmpty(image.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mb-2">@image.Description</MudText>
                            }
                            @if (image.Features.Count > 0)
                            {
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                                    @foreach (string feature in image.Features)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@feature</MudChip>
                                    }
                                </MudStack>
                            }
                            @if (image.Versions.Count > 0)
                            {
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Version</th>
                                            <th>Size</th>
                                            <th>Date</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (VmImageVersion version in image.Versions)
                                        {
                                            <tr>
                                                <td>@version.Version</td>
                                                <td>@version.SizeGb.ToString("F1") GB</td>
                                                <td>@version.Date.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    <MudStack Row="true" Spacing="1">
                                                        @if (_canImport && !version.IsLocallyAvailable)
                                                        {
                                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                                       Disabled="_activeImports.Contains(version.FileName)"
                                                                       OnClick="() => ImportVersion(image, version)">
                                                                @(_activeImports.Contains(version.FileName) ? "Importing..." : "Import")
                                                            </MudButton>
                                                        }
                                                        @if (_canCreateVm && version.IsLocallyAvailable)
                                                        {
                                                            <MudButton Size="Size.Small" Variant="Variant.Filled"
                                                                       Color="Color.Primary"
                                                                       OnClick="() => CreateVmFromCatalog(image, version)">
                                                                Create VM
                                                            </MudButton>
                                                        }
                                                        @if (version.IsLocallyAvailable)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                                                     Variant="Variant.Outlined">Local</MudChip>
                                                        }
                                                    </MudStack>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private List<VmImage> _images = new List<VmImage>();
    private List<LocalImage> _localImages = new List<LocalImage>();
    private string _searchQuery = "";
    private bool _loading = true;
    private bool _canImport;
    private bool _canCreateVm;
    private bool _canDeleteLocal;
    private HashSet<string> _activeImports = new HashSet<string>();
    private ClaimsPrincipal _user = new ClaimsPrincipal();

    private IEnumerable<VmImage> FilteredImages
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchQuery))
                return _images;

            string query = _searchQuery.Trim();
            return _images.Where(i =>
                i.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                i.Description.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                i.Features.Any(f => f.Contains(query, StringComparison.OrdinalIgnoreCase)));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        _user = state.User;
        _canImport = AuthService.HasPermission(_user, Permission.CatalogImport);
        _canCreateVm = AuthService.HasPermission(_user, Permission.VmCreate);
        _canDeleteLocal = AuthService.HasPermission(_user, Permission.CatalogDeleteLocal);
        await LoadAll();
    }

    private async Task LoadAll()
    {
        _loading = true;
        try
        {
            _images = await CatalogAggregator.LoadCatalogAsync();
            LoadLocalImages();
            MarkLocalAvailability();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load catalog: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void MarkLocalAvailability()
    {
        AppSettings settings = SettingsService.Load();
        string extractedRoot = Path.Combine(settings.LocalVmPath, "extracted");
        if (!Directory.Exists(extractedRoot))
            return;

        Dictionary<string, string> localByKey = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (string dir in Directory.GetDirectories(extractedRoot))
        {
            LocalImageMetadata? meta = LocalImageService.LoadMetadata(dir);
            if (meta == null)
                continue;
            string key = (meta.FeedId ?? "") + "|" + (meta.ParentImageId ?? "") + "|" + (meta.Version ?? "");
            localByKey[key] = dir;
        }

        foreach (VmImage img in _images)
        {
            foreach (VmImageVersion ver in img.Versions)
            {
                string key = (ver.FeedId ?? "") + "|" + (ver.ParentImageId ?? "") + "|" + (ver.Version ?? "");
                if (localByKey.ContainsKey(key))
                    ver.IsLocallyAvailable = true;
            }
        }
    }

    private void LoadLocalImages()
    {
        AppSettings settings = SettingsService.Load();
        string extractedDir = Path.Combine(settings.LocalVmPath, "extracted");
        _localImages = new List<LocalImage>();

        if (!Directory.Exists(extractedDir))
            return;

        foreach (string dir in Directory.GetDirectories(extractedDir))
        {
            string[] diskFiles = Directory.GetFiles(dir, "*.vhdx", SearchOption.AllDirectories)
                .Concat(Directory.GetFiles(dir, "*.qcow2", SearchOption.AllDirectories))
                .ToArray();
            if (diskFiles.Length == 0)
                continue;

            DirectoryInfo dirInfo = new DirectoryInfo(dir);
            long totalSize = diskFiles.Sum(f => new FileInfo(f).Length);
            string displayName = dirInfo.Name;
            string? parentImageName = null;
            string? imageVersion = null;

            LocalImageMetadata? meta = LocalImageService.LoadMetadata(dir);
            if (meta != null)
            {
                if (!string.IsNullOrEmpty(meta.Name))
                    displayName = meta.Name;
                parentImageName = meta.ParentImageName;
                imageVersion = meta.Version;
            }

            _localImages.Add(new LocalImage
            {
                Name = displayName,
                Path = dir,
                SizeGb = totalSize / 1073741824.0,
                ExtractedAt = dirInfo.CreationTime,
                ParentImageName = parentImageName,
                ImageVersion = imageVersion,
            });
        }

        _localImages = _localImages.OrderByDescending(l => l.ExtractedAt).ToList();
    }

    private void ImportVersion(VmImage image, VmImageVersion version)
    {
        if (_activeImports.Contains(version.FileName))
            return;
        _activeImports.Add(version.FileName);
        StateHasChanged();

        string username = _user.Identity?.Name ?? "";
        AppSettings settings = SettingsService.Load();
        byte[] hashBytes = System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(version.FileName));
        string storageId = Convert.ToHexString(hashBytes)[..12].ToLowerInvariant();

        TaskManager.StartTask("Importing " + image.Name + " " + version.Version, username, async ctx =>
        {
            string downloadUrl = await CatalogAggregator.GetDownloadUrlAsync(version.FileName);

            System.Net.Http.Headers.AuthenticationHeaderValue? auth = null;
            if (CatalogAggregator.IsNexusVersion(version.FileName))
                auth = CatalogAggregator.GetNexusAuthHeader();
            else if (!CatalogAggregator.IsLocalVersion(version.FileName))
                auth = CatalogAggregator.GetAuthHeader();

            string downloadPath = Path.Combine(settings.LocalVmPath, "downloads", storageId + ".box");
            Directory.CreateDirectory(Path.GetDirectoryName(downloadPath)!);

            ctx.ReportProgress(0, "Downloading...");
            await ImportService.DownloadWithProgressAsync(
                downloadUrl, downloadPath,
                new Progress<DownloadProgress>(p =>
                {
                    double speedMb = p.SpeedBytesPerSec / 1024.0 / 1024.0;
                    double dlMb = p.DownloadedBytes / 1024.0 / 1024.0;
                    double totalMb = p.TotalBytes / 1024.0 / 1024.0;
                    string status = p.Eta.HasValue
                        ? string.Format("Downloading: {0:F0}/{1:F0} MB ({2:F1} MB/s, ~{3:mm\\:ss} remaining)", dlMb, totalMb, speedMb, p.Eta.Value)
                        : string.Format("Downloading: {0:F0} MB ({1:F1} MB/s)", dlMb, speedMb);
                    ctx.ReportProgress(p.Percent / 200.0, status);
                }),
                ctx.Token, auth);

            string extractPath = Path.Combine(settings.LocalVmPath, "extracted", storageId);
            ctx.ReportProgress(0.5, "Extracting...");
            await ImportService.ExtractAsync(
                downloadPath, extractPath,
                new Progress<double>(pct => ctx.ReportProgress(0.5 + pct / 2.0, string.Format("Extracting: {0:F0}%", pct))),
                ctx.Token);

            LocalImageService.SaveMetadata(extractPath, version);

            if (OperatingSystem.IsLinux())
            {
                string? vhdxFile = Directory.GetFiles(extractPath, "*.vhdx", SearchOption.AllDirectories)
                    .Concat(Directory.GetFiles(extractPath, "*.avhdx", SearchOption.AllDirectories))
                    .FirstOrDefault();
                bool hasQcow2 = Directory.GetFiles(extractPath, "*.qcow2", SearchOption.AllDirectories).Any();
                if (vhdxFile != null && !hasQcow2)
                {
                    ctx.ReportProgress(0.95, "Converting VHDX to QCOW2...");
                    string qcow2File = Path.ChangeExtension(vhdxFile, ".qcow2");
                    System.Diagnostics.Process proc = new System.Diagnostics.Process
                    {
                        StartInfo = new System.Diagnostics.ProcessStartInfo
                        {
                            FileName = "qemu-img",
                            Arguments = $"convert -O qcow2 \"{vhdxFile}\" \"{qcow2File}\"",
                            RedirectStandardError = true,
                            UseShellExecute = false,
                        },
                    };
                    proc.Start();
                    await proc.WaitForExitAsync(ctx.Token);
                    if (proc.ExitCode != 0)
                    {
                        string stderr = await proc.StandardError.ReadToEndAsync();
                        throw new InvalidOperationException("qemu-img convert failed: " + stderr);
                    }
                    File.Delete(vhdxFile);
                }
            }

            ctx.ReportProgress(1.0, "Complete");
            await InvokeAsync(() =>
            {
                _activeImports.Remove(version.FileName);
                StateHasChanged();
            });
        });

        Snackbar.Add("Importing " + image.Name + " " + version.Version + "...", Severity.Info);
    }

    private async Task CreateVmFromCatalog(VmImage image, VmImageVersion version)
    {
        AppSettings settings = SettingsService.Load();
        byte[] hashBytes = System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(version.FileName));
        string storageId = Convert.ToHexString(hashBytes)[..12].ToLowerInvariant();
        string extractedPath = Path.Combine(settings.LocalVmPath, "extracted", storageId);

        if (!Directory.Exists(extractedPath))
        {
            Snackbar.Add("Local image not found. Import it first.", Severity.Warning);
            return;
        }

        LocalImage local = new LocalImage
        {
            Name = image.Name,
            Path = extractedPath,
            ParentImageName = image.Name,
            ImageVersion = version.Version,
        };

        DialogParameters<DialogCreateVm> parameters = new DialogParameters<DialogCreateVm>
        {
            { x => x.LocalImage, local },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogCreateVm>("Create VM", parameters);
        DialogResult? result = await dialog.Result;

        if (!(result?.Canceled ?? true) && result.Data is string vmName)
        {
            string username = _user.Identity?.Name ?? "";
            VmOrigin origin = new VmOrigin
            {
                ImageId = image.Id,
                ImageName = image.Name,
                Version = version.Version,
                FeedId = version.FeedId,
                FeedUrl = version.FeedUrl,
                Repository = version.FeedRepository,
            };

            TaskManager.StartTask("Creating VM: " + vmName, username, async ctx =>
            {
                ctx.ReportProgress(0.0, "Importing disk image...");
                await VmBackend.ImportVmAsync(
                    extractedPath, settings.LocalVmPath,
                    settings.DefaultMemoryMb, settings.DefaultCpuCount, vmName,
                    onStatus: status => ctx.ReportProgress(-1, status),
                    cancellationToken: ctx.Token);

                TrackingService.TrackVm(vmName, origin);
                OwnershipService.SetOwner(vmName, username);

                bool applyLocale = settings.ApplyLocaleOnCreate && !string.IsNullOrWhiteSpace(settings.DefaultLocale);
                bool needsPostCreation = settings.RenameComputerToVmName || !string.IsNullOrWhiteSpace(settings.PostCreationScript);

                if ((applyLocale || needsPostCreation)
                    && !string.IsNullOrWhiteSpace(settings.DefaultVmUsername)
                    && !string.IsNullOrWhiteSpace(settings.DefaultVmPassword))
                {
                    ctx.ReportProgress(-1, "Configuring VM...");
                    await VmBackend.ConfigureAndFinalizeAsync(
                        vmName, settings.DefaultVmUsername, settings.DefaultVmPassword,
                        applyLocale ? settings.DefaultLocale : null,
                        applyLocale ? settings.DefaultKeyboardLayout : null,
                        applyLocale ? settings.DefaultTimezone : null,
                        settings.RenameComputerToVmName, settings.PostCreationScript,
                        onStatus: status => ctx.ReportProgress(-1, status));
                }
                else
                {
                    ctx.ReportProgress(-1, "Creating base snapshot...");
                    await VmBackend.CreateSnapshotAsync(vmName, "Base");
                }

                ctx.ReportProgress(1.0, "VM created");
            });
            Snackbar.Add("Creating VM '" + vmName + "' in background...", Severity.Info);
        }
    }

    private async Task CreateVmFromLocal(LocalImage local)
    {
        DialogParameters<DialogCreateVm> parameters = new DialogParameters<DialogCreateVm>
        {
            { x => x.LocalImage, local },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogCreateVm>("Create VM", parameters);
        DialogResult? result = await dialog.Result;

        if (!(result?.Canceled ?? true) && result.Data is string vmName)
        {
            string username = _user.Identity?.Name ?? "";
            AppSettings settings = SettingsService.Load();
            VmOrigin? origin = null;
            if (!string.IsNullOrEmpty(local.ParentImageName))
            {
                origin = new VmOrigin
                {
                    ImageName = local.ParentImageName ?? "",
                    Version = local.ImageVersion ?? "",
                    FeedId = local.FeedId ?? "",
                    FeedUrl = local.FeedUrl ?? "",
                    Repository = local.FeedRepository,
                };
            }

            TaskManager.StartTask("Creating VM: " + vmName, username, async ctx =>
            {
                ctx.ReportProgress(0.0, "Importing disk image...");
                await VmBackend.ImportVmAsync(
                    local.Path,
                    settings.LocalVmPath,
                    settings.DefaultMemoryMb,
                    settings.DefaultCpuCount,
                    vmName,
                    onStatus: status => ctx.ReportProgress(-1, status),
                    cancellationToken: ctx.Token);

                TrackingService.TrackVm(vmName, origin);
                OwnershipService.SetOwner(vmName, username);

                bool applyLocale = settings.ApplyLocaleOnCreate && !string.IsNullOrWhiteSpace(settings.DefaultLocale);
                bool needsPostCreation = settings.RenameComputerToVmName || !string.IsNullOrWhiteSpace(settings.PostCreationScript);

                if ((applyLocale || needsPostCreation)
                    && !string.IsNullOrWhiteSpace(settings.DefaultVmUsername)
                    && !string.IsNullOrWhiteSpace(settings.DefaultVmPassword))
                {
                    ctx.ReportProgress(-1, "Configuring VM...");
                    await VmBackend.ConfigureAndFinalizeAsync(
                        vmName, settings.DefaultVmUsername, settings.DefaultVmPassword,
                        applyLocale ? settings.DefaultLocale : null,
                        applyLocale ? settings.DefaultKeyboardLayout : null,
                        applyLocale ? settings.DefaultTimezone : null,
                        settings.RenameComputerToVmName, settings.PostCreationScript,
                        onStatus: status => ctx.ReportProgress(-1, status));
                }
                else
                {
                    ctx.ReportProgress(-1, "Creating base snapshot...");
                    await VmBackend.CreateSnapshotAsync(vmName, "Base");
                }

                ctx.ReportProgress(1.0, "VM created");
            });
            Snackbar.Add("Creating VM '" + vmName + "' in background...", Severity.Info);
        }
    }

    private async Task DeleteLocalImage(LocalImage local)
    {
        DialogParameters<DialogConfirm> parameters = new DialogParameters<DialogConfirm>
        {
            { x => x.Message, "Delete local image '" + local.DisplayName + "'? The extracted files will be removed." },
            { x => x.ConfirmText, "Delete" },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogConfirm>("Delete Local Image", parameters);
        DialogResult? result = await dialog.Result;

        if (!(result?.Canceled ?? true))
        {
            try
            {
                if (Directory.Exists(local.Path))
                    Directory.Delete(local.Path, true);
                LoadLocalImages();
                Snackbar.Add("Image deleted", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Failed: " + ex.Message, Severity.Error);
            }
        }
    }
}
