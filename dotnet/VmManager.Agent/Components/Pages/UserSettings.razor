@page "/settings"
@using VmManager.Agent.Services
@attribute [Authorize]
@inject BasicAuthStateProvider AuthState
@inject UserService UserService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4">My Settings</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Profile</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="_email" Label="Email" Class="mb-2" />
                <MudTextField Value="@_displayUsername" Label="Username" ReadOnly="true" Class="mb-2" />
            </MudCardContent>
            <MudCardActions>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProfile">
                    Save Profile
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Change Password</MudText>
            </MudCardHeader>
            <MudCardContent>
                @if (!string.IsNullOrEmpty(_passwordError))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_passwordError</MudAlert>
                }
                <MudTextField @bind-Value="_newPassword" Label="New Password"
                              InputType="InputType.Password" Immediate="true" Class="mb-2" />
                <MudTextField @bind-Value="_confirmPassword" Label="Confirm Password"
                              InputType="InputType.Password" Immediate="true" Class="mb-2" />
            </MudCardContent>
            <MudCardActions>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChangePassword">
                    Change Password
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Elevation="2">
            <MudCardHeader>
                <MudText Typo="Typo.h6">VM Credentials</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Override the default Windows login for VMs. Leave empty to use the VM or global default.
                </MudText>
                <MudTextField @bind-Value="_vmUsername" Label="VM Username"
                              HelperText="e.g. Administrator or DOMAIN\user" Class="mb-2" />
                <MudTextField @bind-Value="_vmPassword" Label="VM Password"
                              InputType="InputType.Password" Class="mb-2"
                              Placeholder="@(_hasVmCredentials ? "********" : "")" />
            </MudCardContent>
            <MudCardActions>
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveVmCredentials">
                    Save VM Credentials
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private string _email = "";
    private string _displayUsername = "";
    private string _vmUsername = "";
    private string _vmPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string _passwordError = "";

    private bool _hasVmCredentials;

    protected override void OnInitialized()
    {
        UserAccount? user = UserService.GetByUsername(AuthState.CurrentUsername);
        if (user != null)
        {
            _email = user.Email;
            _displayUsername = user.DisplayUsername;
            _vmUsername = user.VmUsername;
            _hasVmCredentials = !string.IsNullOrEmpty(user.VmUsername);
        }
    }

    private void SaveProfile()
    {
        try
        {
            UserService.UpdateEmail(AuthState.CurrentUsername, _email.Trim());
            UserService.UpdateDisplayUsername(AuthState.CurrentUsername, _displayUsername);
            Snackbar.Add("Profile saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed: " + ex.Message, Severity.Error);
        }
    }

    private void SaveVmCredentials()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_vmUsername))
            {
                UserService.UpdateVmCredentials(AuthState.CurrentUsername, "", "");
                _hasVmCredentials = false;
            }
            else
            {
                UserAccount? user = UserService.GetByUsername(AuthState.CurrentUsername);
                string passwordToSave = string.IsNullOrEmpty(_vmPassword) && user != null
                    ? user.VmPassword
                    : _vmPassword;
                UserService.UpdateVmCredentials(AuthState.CurrentUsername, _vmUsername.Trim(), passwordToSave);
                _hasVmCredentials = true;
            }
            _vmPassword = "";
            Snackbar.Add("VM credentials saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed: " + ex.Message, Severity.Error);
        }
    }

    private void ChangePassword()
    {
        _passwordError = "";

        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6)
        {
            _passwordError = "Password must be at least 6 characters.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _passwordError = "Passwords do not match.";
            return;
        }

        try
        {
            UserService.ChangePassword(AuthState.CurrentUsername, _newPassword);
            _newPassword = "";
            _confirmPassword = "";
            Snackbar.Add("Password changed", Severity.Success);
        }
        catch (Exception ex)
        {
            _passwordError = ex.Message;
        }
    }
}
