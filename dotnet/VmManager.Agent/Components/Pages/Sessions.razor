@page "/sessions"
@using System.Security.Claims
@using VmManager.Agent.Services
@attribute [Authorize]
@inject RdpSessionStore SessionStore
@inject BasicAuthStateProvider AuthState
@inject AuthorizationService AuthService
@inject SettingsService SettingsService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Active Sessions</MudText>
    @if (_sessions.Count > 0)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info">@_sessions.Count sessions</MudChip>
    }
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadSessions" />
</MudStack>

@if (_sessions.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Filled.ScreenShare" />
        <MudText Typo="Typo.h6" Color="Color.Secondary">No active sessions</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">RDP sessions will appear here when users connect to VMs.</MudText>
    </div>
}
else
{
    <MudGrid>
        @foreach (IGrouping<string, RdpSession> group in _sessions.GroupBy(s => s.VmName))
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">@group.Key</MudText>
                        <MudSpacer />
                        @if (_isAdmin)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       OnClick="() => ShowShadow(group.Key)">
                                Shadow
                            </MudButton>
                        }
                        <MudChip T="string" Size="Size.Small" Class="ml-2">@group.Count() sessions</MudChip>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>State</th>
                                    <th>Connected</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (RdpSession session in group)
                                {
                                    <tr>
                                        <td>@session.Username</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(session.State == RdpSessionState.Active ? Color.Success : Color.Default)">
                                                @session.State
                                            </MudChip>
                                        </td>
                                        <td>@session.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Size="Size.Small" Color="Color.Error"
                                                           OnClick="() => Disconnect(session)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<RdpSession> _sessions = new List<RdpSession>();
    private Timer? _pollTimer;
    private bool _isAdmin;
    private string _proxyAddress = "";

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");

        AppSettings settings = SettingsService.Load();
        string host = new Uri(NavigationManager.BaseUri).Host;
        _proxyAddress = !string.IsNullOrEmpty(settings.RdpDomainSuffix)
            ? "{vmName}." + settings.RdpDomainSuffix
            : host + ":13389";

        LoadSessions();
        _pollTimer = new Timer(_ => InvokeAsync(LoadSessions), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private void LoadSessions()
    {
        _sessions = SessionStore.GetAllSessions()
            .Where(s => s.State == RdpSessionState.Active)
            .ToList();
        StateHasChanged();
    }

    private async Task ShowShadow(string vmName)
    {
        AppSettings settings = SettingsService.Load();
        string address = _proxyAddress.Replace("{vmName}", vmName);

        string message = "To shadow an active session on " + vmName + ", run the following command on your local machine:\n\n"
            + "mstsc /v:" + address + " /shadow:{SESSION_ID} /control\n\n"
            + "Replace {SESSION_ID} with the Windows session ID (use 'query session' on the VM to find it).";

        DialogParameters<DialogConfirm> parameters = new DialogParameters<DialogConfirm>
        {
            { x => x.Message, message },
            { x => x.ConfirmText, "Close" },
        };
        await DialogService.ShowAsync<DialogConfirm>("Shadow Session - " + vmName, parameters);
    }

    private void Disconnect(RdpSession session)
    {
        SessionStore.ForceDisconnect(session.Token);
        Snackbar.Add("Session disconnected", Severity.Success);
        LoadSessions();
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}
