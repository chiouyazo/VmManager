@page "/vms"
@page "/"
@using System.Security.Claims
@using Microsoft.JSInterop
@using VmManager.Agent.Services
@using VmManager.Backends.Proxmox
@attribute [Authorize]
@inject IVmBackend VmBackend
@inject AuthorizationService AuthService
@inject BasicAuthStateProvider AuthState
@inject VmOwnershipService OwnershipService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject SettingsService SettingsService
@inject IVmTrackingService TrackingService
@inject SnapshotPushService PushService
@inject FeedResolutionService FeedResolution
@inject VmCredentialStore CredentialStore
@inject IVmIpResolver VmIpResolver
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IBackgroundTaskManager TaskManager
@inject IServiceProvider ServiceProvider

<MudStack Row="true" AlignItems="AlignItems.Stretch" Class="mb-4">
    <MudText Typo="Typo.h5" Class="py-2">My VMs</MudText>
    <MudTextField @bind-Value="_searchQuery" Placeholder="Search..."
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense"
                  Immediate="true" DebounceInterval="300" Class="mt-0" Style="max-width: 220px;" />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadVms" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (FilteredVms.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" />
        <MudText Typo="Typo.h6" Color="Color.Secondary">No VMs found</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Create a VM from the Images page or adjust your filters.</MudText>
    </div>
}
else
{
    <MudGrid>
        @foreach (VmInstance vm in FilteredVms)
        {
            <MudItem xs="12" sm="12" md="12" lg="6">
                <MudCard Elevation="1" Class="vm-card">
                    <MudCardHeader>
                        <MudIconButton Icon="@(_expandedVm == vm.Name ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                       Size="Size.Small" OnClick="() => ToggleExpand(vm)" />
                        <MudText Typo="Typo.body1" Style="font-weight: 600;">@vm.Name</MudText>
                        <MudChip T="string" Color="@GetStateColor(vm.State)" Size="Size.Small" Class="mx-3"
                                 Variant="Variant.Filled">
                            @vm.State
                        </MudChip>
                        @if (vm.State == "Running" && _reachability.TryGetValue(vm.Name, out bool reachable))
                        {
                            <MudChip T="string" Size="Size.Small" Class="mr-2"
                                     Color="@(reachable ? Color.Success : Color.Warning)"
                                     Variant="Variant.Outlined">
                                @(reachable ? "Ready" : "Unreachable")
                            </MudChip>
                        }
                        <MudSpacer />
                        @if (CanDo(vm, Permission.RdpConnect) && vm.State == "Running")
                        {
                            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.PlayArrow"
                                       Size="Size.Small" Color="Color.Info" OnClick="() => Connect(vm)">
                                Connect
                            </MudButton>
                        }
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Color="Color.Default" Class="ml-1">
                            @if (vm.State != "Running" && CanDo(vm, Permission.VmStart))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" OnClick="() => Start(vm)">Start</MudMenuItem>
                            }
                            @if (vm.State == "Running" && CanDo(vm, Permission.VmStop))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Stop" OnClick="() => Stop(vm)">Stop</MudMenuItem>
                            }
                            @if (CanDo(vm, Permission.VmRename))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => Rename(vm)">Rename</MudMenuItem>
                            }
                            @if (IsOwnerOrAdmin(vm))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="() => Share(vm)">Share</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Key" OnClick="() => SetVmCredentials(vm)">VM Credentials</MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.Login" OnClick="() => SetMyLogin(vm)">My Login</MudMenuItem>
                            @if (_canManageTemplates && VmBackend is ProxmoxService)
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Dashboard" OnClick="() => MakeTemplate(vm)">Make Template</MudMenuItem>
                            }
                            @if (CanDo(vm, Permission.VmReset))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" OnClick="() => ResetToBase(vm)">Reset to Base</MudMenuItem>
                            }
                            @if (CanDo(vm, Permission.VmDelete))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => Delete(vm)">Delete</MudMenuItem>
                            }
                        </MudMenu>
                    </MudCardHeader>

                    @if (_expandedVm == vm.Name)
                    {
                        <MudCardContent>
                            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2">
                                <MudTabPanel Text="Snapshots" Icon="@Icons.Material.Filled.Camera">
                                    @if (_snapshotsLoading)
                                    {
                                        <MudProgressLinear Indeterminate="true" />
                                    }
                                    else
                                    {
                                        @if (CanDo(vm, Permission.SnapshotCreate))
                                        {
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                                                <MudTextField @bind-Value="_newSnapshotName" Placeholder="Snapshot name"
                                                              Size="Size.Small" Immediate="true" Style="max-width: 250px;" />
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           Disabled="@string.IsNullOrWhiteSpace(_newSnapshotName)"
                                                           OnClick="() => CreateSnapshot(vm)">
                                                    Create
                                                </MudButton>
                                            </MudStack>
                                        }
                                        @if (_snapshots.Count == 0)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">No snapshots</MudText>
                                        }
                                        else
                                        {
                                            <MudSimpleTable Dense="true" Hover="true">
                                                <thead>
                                                    <tr>
                                                        <th>Name</th>
                                                        <th>Created</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (VmSnapshot snapshot in _snapshots)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @snapshot.Name
                                                                @if (snapshot.IsBase)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-1">Base</MudChip>
                                                                }
                                                            </td>
                                                            <td>@snapshot.CreationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                                            <td>
                                                                <MudStack Row="true" Spacing="0">
                                                                    @if (CanDo(vm, Permission.SnapshotRestore))
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small"
                                                                                       Title="Restore"
                                                                                       OnClick="() => RestoreSnapshot(vm, snapshot)" />
                                                                    }
                                                                    @if (CanDo(vm, Permission.SnapshotClone))
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                                                       Title="Clone from snapshot"
                                                                                       OnClick="() => CloneFromSnapshot(vm, snapshot)" />
                                                                    }
                                                                    @if (CanDo(vm, Permission.SnapshotPush))
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small"
                                                                                       Title="Push to feed"
                                                                                       OnClick="() => PushSnapshot(vm, snapshot)" />
                                                                    }
                                                                    @if (snapshot.IsNotBase && CanDo(vm, Permission.SnapshotDelete))
                                                                    {
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                                                       Color="Color.Error" Title="Delete"
                                                                                       OnClick="() => DeleteSnapshot(vm, snapshot)" />
                                                                    }
                                                                </MudStack>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </MudSimpleTable>
                                        }
                                    }
                                </MudTabPanel>
                                <MudTabPanel Text="Notes" Icon="@Icons.Material.Filled.Notes">
                                    <MudTextField @bind-Value="_currentNotes" Lines="4" Variant="Variant.Outlined"
                                                  Placeholder="Add notes about this VM..."
                                                  DebounceInterval="1000"
                                                  OnDebounceIntervalElapsed="() => SaveNotes(vm)" />
                                </MudTabPanel>
                            </MudTabs>
                        </MudCardContent>
                    }

                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@implements IDisposable

@code
{
    private List<VmInstance> _vms = new List<VmInstance>();
    private ClaimsPrincipal _user = new ClaimsPrincipal();
    private string _domainSuffix = "";
    private string _searchQuery = "";
    private string _stateFilter = "All";
    private string? _expandedVm;
    private bool _loading = true;
    private bool _canManageTemplates;
    private Dictionary<string, bool> _reachability = new Dictionary<string, bool>();
    private Timer? _reachabilityTimer;

    private List<VmSnapshot> _snapshots = new List<VmSnapshot>();
    private bool _snapshotsLoading;
    private string _newSnapshotName = "";
    private string _currentNotes = "";

    private List<VmInstance> FilteredVms
    {
        get
        {
            IEnumerable<VmInstance> result = _vms;

            if (_stateFilter != "All")
                result = result.Where(v => v.State == _stateFilter);

            if (!string.IsNullOrWhiteSpace(_searchQuery))
                result = result.Where(v => v.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));

            return result.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AppSettings settings = SettingsService.Load();
        _domainSuffix = settings.RdpDomainSuffix;
        await LoadVms();
        _canManageTemplates = AuthService.HasPermission(_user, Permission.TemplateManage);
        _ = CheckReachabilityAsync();
        _reachabilityTimer = new Timer(_ => InvokeAsync(CheckReachabilityAsync), null,
            TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    public void Dispose()
    {
        _reachabilityTimer?.Dispose();
    }

    private async Task LoadVms()
    {
        _loading = true;
        _user = (await AuthState.GetAuthenticationStateAsync()).User;
        List<VmInstance> vmInstances = await VmBackend.GetVmsAsync();
        _vms = vmInstances.Where(vm => AuthService.CanViewVm(_user, vm.Name)).ToList();
        _loading = false;
    }

    private async Task CheckReachabilityAsync()
    {
        List<VmInstance> runningVms = _vms.Where(vm => vm.State == "Running").ToList();
        if (runningVms.Count == 0)
            return;

        List<Task> checks = new List<Task>();
        foreach (VmInstance vm in runningVms)
        {
            string vmName = vm.Name;
            checks.Add(Task.Run(async () =>
            {
                try
                {
                    string? ip = await VmIpResolver.ResolveIpAsync(vmName);
                    if (ip == null)
                    {
                        _reachability[vmName] = false;
                        return;
                    }
                    using System.Net.Sockets.TcpClient tcp = new System.Net.Sockets.TcpClient();
                    Task connectTask = tcp.ConnectAsync(ip, 3389);
                    bool connected = await Task.WhenAny(connectTask, Task.Delay(2000)) == connectTask
                        && tcp.Connected;
                    _reachability[vmName] = connected;
                }
                catch
                {
                    _reachability[vmName] = false;
                }
            }));
        }

        await Task.WhenAll(checks);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleExpand(VmInstance vm)
    {
        if (_expandedVm == vm.Name)
        {
            _expandedVm = null;
            return;
        }

        _expandedVm = vm.Name;
        _snapshotsLoading = true;
        _newSnapshotName = "";
        _currentNotes = TrackingService.LoadNotes().GetValueOrDefault(vm.Name, "");

        try
        {
            _snapshots = await VmBackend.GetSnapshotsAsync(vm.Name);
        }
        catch
        {
            _snapshots = new List<VmSnapshot>();
        }
        _snapshotsLoading = false;
    }

    private async Task Connect(VmInstance vm)
    {
        string username = _user.Identity?.Name ?? "";
        string address;
        string displayUsername;

        if (!string.IsNullOrEmpty(_domainSuffix))
        {
            address = vm.Name + "." + _domainSuffix;
            displayUsername = username;
        }
        else
        {
            string host = new Uri(NavigationManager.BaseUri).Host;
            address = host + ":13389";
            displayUsername = vm.Name + ":" + username;
        }

        DialogParameters<DialogConnect> parameters = new DialogParameters<DialogConnect>
        {
            { x => x.Address, address },
            { x => x.Username, displayUsername },
        };

        await DialogService.ShowAsync<DialogConnect>("Connect to " + vm.Name, parameters);
    }

    private void Start(VmInstance vm)
    {
        _reachability[vm.Name] = false;
        string username = _user.Identity?.Name ?? "";
        TaskManager.StartTask("Starting " + vm.Name, username, async ctx =>
        {
            ctx.ReportProgress(0, "Sending start command...");
            await VmBackend.StartVmAsync(vm.Name);
            vm.State = "Running";
            ctx.ReportProgress(1.0, "Started");
            await InvokeAsync(StateHasChanged);
            _ = CheckReachabilityAsync();
        });
    }

    private void Stop(VmInstance vm)
    {
        string username = _user.Identity?.Name ?? "";
        TaskManager.StartTask("Stopping " + vm.Name, username, async ctx =>
        {
            ctx.ReportProgress(0, "Sending stop command...");
            await VmBackend.StopVmAsync(vm.Name);
            vm.State = "Off";
            ctx.ReportProgress(1.0, "Stopped");
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task Delete(VmInstance vm)
    {
        if (await Confirm("Delete VM", "Are you sure you want to delete " + vm.Name + "? This cannot be undone.", "Delete"))
        {
            try
            {
                await VmBackend.DeleteVmAsync(vm.Name);
                TrackingService.UntrackVm(vm.Name);
                OwnershipService.RemoveOwner(vm.Name);
                CredentialStore.RemoveAllForVm(vm.Name);
                _vms.Remove(vm);
                Snackbar.Add(vm.Name + " deleted", Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add("Failed: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task Rename(VmInstance vm)
    {
        DialogParameters<DialogRenameVm> parameters = new DialogParameters<DialogRenameVm> { { x => x.Vm, vm } };
        IDialogReference dialog = await DialogService.ShowAsync<DialogRenameVm>("Rename VM", parameters);
        DialogResult? result = await dialog.Result;

        if (!(result?.Canceled ?? true) && result.Data is string newName)
        {
            try
            {
                await VmBackend.RenameVmAsync(vm.Name, newName);
                OwnershipService.RenameVm(vm.Name, newName);
                vm.Name = newName;
                Snackbar.Add("Renamed to " + newName, Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add("Failed: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task Share(VmInstance vm)
    {
        string owner = OwnershipService.GetOwner(vm.Name);
        DialogParameters<DialogShareVm> parameters = new DialogParameters<DialogShareVm>
        {
            { x => x.VmName, vm.Name },
            { x => x.OwnerUsername, owner },
        };
        await DialogService.ShowAsync<DialogShareVm>("Share " + vm.Name, parameters);
    }

    private async Task MakeTemplate(VmInstance vm)
    {
        DialogParameters<DialogMakeTemplate> parameters = new DialogParameters<DialogMakeTemplate>
        {
            { x => x.SourceVmName, vm.Name },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogMakeTemplate>(
            "Make Template from " + vm.Name, parameters);
        DialogResult? result = await dialog.Result;

        if ((result?.Canceled ?? true) || result.Data is not ValueTuple<string, string> data)
            return;

        if (VmBackend is not ProxmoxService proxmox)
        {
            Snackbar.Add("Templates are only supported on Proxmox.", Severity.Warning);
            return;
        }

        (string templateName, string description) = data;
        string username = _user.Identity?.Name ?? "";
        AppSettings settings = SettingsService.Load();
        VmOrigin? origin = TrackingService.GetOrigin(vm.Name);
        VmTemplateStore? store = ServiceProvider.GetService<VmTemplateStore>();

        TaskManager.StartTask("Creating template from " + vm.Name, username, async ctx =>
        {
            ctx.ReportProgress(-1, "Cloning VM and converting to template...");
            int templateVmId = await proxmox.Import.ConvertVmToTemplateAsync(
                vm.Name, templateName,
                onStatus: status => ctx.ReportProgress(-1, status),
                cancellationToken: ctx.Token);

            store?.Add(new VmTemplate
            {
                TemplateVmId = templateVmId,
                Name = templateName,
                Description = description,
                CreatedBy = username,
                CreatedAt = DateTime.UtcNow,
                SourceVmName = vm.Name,
                MemoryMb = settings.DefaultMemoryMb,
                CpuCount = settings.DefaultCpuCount,
                Origin = origin,
            });

            ctx.ReportProgress(1.0, "Template created");
        });
        Snackbar.Add("Creating template '" + templateName + "' from '" + vm.Name + "'...", Severity.Info);
    }

    private async Task ResetToBase(VmInstance vm)
    {
        if (await Confirm("Reset to Base", "Reset " + vm.Name + " to its base snapshot? All changes will be lost.", "Reset"))
        {
            try
            {
                await VmBackend.ResetDiskAsync(vm.Name);
                Snackbar.Add(vm.Name + " reset to base", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Failed: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task CreateSnapshot(VmInstance vm)
    {
        string? snapshotName = SnapshotNameValidator.Sanitize(_newSnapshotName.Trim());
        if (snapshotName == null)
        {
            Snackbar.Add("Invalid snapshot name.", Severity.Warning);
            return;
        }

        try
        {
            await VmBackend.CreateSnapshotAsync(vm.Name, snapshotName);
            _newSnapshotName = "";
            _snapshots = await VmBackend.GetSnapshotsAsync(vm.Name);
            Snackbar.Add($"Snapshot '{snapshotName}' created", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed: " + ex.Message, Severity.Error);
        }
    }

    private async Task RestoreSnapshot(VmInstance vm, VmSnapshot snapshot)
    {
        if (await Confirm("Restore Snapshot", "Restore " + vm.Name + " to snapshot '" + snapshot.Name + "'?", "Restore"))
        {
            try
            {
                await VmBackend.RestoreSnapshotAsync(vm.Name, snapshot.Id);
                Snackbar.Add("Snapshot restored", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Failed: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task DeleteSnapshot(VmInstance vm, VmSnapshot snapshot)
    {
        if (await Confirm("Delete Snapshot", "Delete snapshot '" + snapshot.Name + "' from " + vm.Name + "?", "Delete"))
        {
            try
            {
                await VmBackend.DeleteSnapshotAsync(vm.Name, snapshot.Id);
                _snapshots = await VmBackend.GetSnapshotsAsync(vm.Name);
                Snackbar.Add("Snapshot deleted", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add("Failed: " + ex.Message, Severity.Error);
            }
        }
    }

    private async Task CloneFromSnapshot(VmInstance vm, VmSnapshot snapshot)
    {
        DialogParameters<DialogRenameVm> parameters = new DialogParameters<DialogRenameVm>
        {
            { x => x.Vm, new VmInstance { Name = vm.Name + "-clone" } },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogRenameVm>("Clone VM", parameters);
        DialogResult? result = await dialog.Result;

        if (!(result?.Canceled ?? true) && result.Data is string newName)
        {
            string username = _user.Identity?.Name ?? "";
            TaskManager.StartTask("Cloning " + vm.Name + " -> " + newName, username, async ctx =>
            {
                ctx.ReportProgress(-1, "Cloning from snapshot '" + snapshot.Name + "'...");
                await VmBackend.CloneVmFromSnapshotAsync(vm.Name, snapshot.Name, newName);
                TrackingService.TrackVm(newName, TrackingService.GetOrigin(vm.Name));
                OwnershipService.SetOwner(newName, username);
                ctx.ReportProgress(1.0, "Clone complete");
            });
            Snackbar.Add("Cloning '" + vm.Name + "' to '" + newName + "'...", Severity.Info);
        }
    }

    private async Task PushSnapshot(VmInstance vm, VmSnapshot snapshot)
    {
        AppSettings settings = SettingsService.Load();
        VmOrigin? origin = TrackingService.GetOrigin(vm.Name);
        FeedConfiguration? feed = FeedResolution.ResolvePushFeed(origin, settings);

        if (feed == null)
        {
            Snackbar.Add("No feed configured to push to. Set up a feed in Agent Settings.", Severity.Warning);
            return;
        }

        if (await Confirm("Push Snapshot",
            "Push snapshot '" + snapshot.Name + "' from " + vm.Name + " to feed '" + feed.Name + "'?",
            "Push"))
        {
            string username = _user.Identity?.Name ?? "";
            TaskManager.StartTask("Pushing " + vm.Name + "/" + snapshot.Name, username, async ctx =>
            {
                ctx.ReportProgress(0, "Preparing push...");
                await PushService.PushAsync(
                    feed, vm.Name, snapshot.Name, snapshot.Id, origin,
                    new Progress<PushProgress>(p =>
                    {
                        ctx.ReportProgress(p.Percent / 100.0,
                            p.Phase + (string.IsNullOrEmpty(p.SpeedText) ? "" : " (" + p.SpeedText + ")"));
                    }),
                    ctx.Token);
                ctx.ReportProgress(1.0, "Push complete");
            });
            Snackbar.Add("Pushing snapshot to '" + feed.Name + "'...", Severity.Info);
        }
    }

    private async Task SetVmCredentials(VmInstance vm)
    {
        (string? currentUser, string? currentPass) = TrackingService.GetVmCredentials(vm.Name);
        bool hasExisting = !string.IsNullOrEmpty(currentUser);
        DialogParameters<DialogVmCredentials> parameters = new DialogParameters<DialogVmCredentials>
        {
            { x => x.CurrentVmUsername, currentUser ?? "" },
            { x => x.HasExisting, hasExisting },
            { x => x.Description, "Set the default Windows login for this VM. Other users will use these credentials unless they set their own." },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogVmCredentials>(
            "VM Credentials: " + vm.Name, parameters);
        DialogResult? result = await dialog.Result;
        if (!(result?.Canceled ?? true) && result.Data is ValueTuple<string, string> creds)
        {
            string passwordToSave = string.IsNullOrEmpty(creds.Item2) && hasExisting
                ? currentPass ?? ""
                : creds.Item2;
            TrackingService.SetVmCredentials(vm.Name, creds.Item1, passwordToSave);
            Snackbar.Add("VM credentials saved", Severity.Success);
        }
    }

    private async Task SetMyLogin(VmInstance vm)
    {
        string currentUsername = _user.Identity?.Name ?? "";
        (string? currentUser, string? currentPass) = CredentialStore.GetCredentials(vm.Name, currentUsername);
        bool hasExisting = !string.IsNullOrEmpty(currentUser);
        DialogParameters<DialogVmCredentials> parameters = new DialogParameters<DialogVmCredentials>
        {
            { x => x.CurrentVmUsername, currentUser ?? "" },
            { x => x.HasExisting, hasExisting },
            { x => x.Description, "Set your personal Windows login for this VM. This overrides the VM default and your global credentials." },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogVmCredentials>(
            "My Login: " + vm.Name, parameters);
        DialogResult? result = await dialog.Result;
        if (!(result?.Canceled ?? true) && result.Data is ValueTuple<string, string> creds)
        {
            string passwordToSave = string.IsNullOrEmpty(creds.Item2) && hasExisting
                ? currentPass ?? ""
                : creds.Item2;
            CredentialStore.SetCredentials(vm.Name, currentUsername, creds.Item1, passwordToSave);
            Snackbar.Add("Personal login saved", Severity.Success);
        }
    }

    private void SaveNotes(VmInstance vm)
    {
        TrackingService.SaveNote(vm.Name, _currentNotes);
    }

    private bool CanDo(VmInstance vm, string permission)
    {
        return AuthService.CanAccessVm(_user, vm.Name, permission);
    }

    private bool IsOwnerOrAdmin(VmInstance vm)
    {
        return AuthService.IsOwnerOrAdmin(_user, vm.Name);
    }

    private async Task<bool> Confirm(string title, string message, string confirmText = "Confirm")
    {
        DialogParameters<DialogConfirm> parameters = new DialogParameters<DialogConfirm>
        {
            { x => x.Message, message },
            { x => x.ConfirmText, confirmText },
        };
        IDialogReference dialog = await DialogService.ShowAsync<DialogConfirm>(title, parameters);
        DialogResult? result = await dialog.Result;
        return !(result?.Canceled ?? true);
    }

    private static Color GetStateColor(string state)
    {
        return state switch
        {
            "Running" => Color.Success,
            "Off" => Color.Default,
            "Saved" => Color.Warning,
            "Paused" => Color.Warning,
            _ => Color.Default,
        };
    }
}
