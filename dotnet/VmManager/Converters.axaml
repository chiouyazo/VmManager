<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:VmManager.Converters"
>
  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
  <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter" />
  <conv:VmStateToBrushConverter x:Key="VmStateToBrushConverter" />
  <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
  <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibilityConverter" />
  <conv:BackendDisplayNameConverter x:Key="BackendDisplayNameConverter" />
  <conv:BackendToExpandedConverter x:Key="BackendToExpandedConverter" />
  <conv:VmStateIsOffConverter x:Key="VmStateIsOffConverter" />
  <conv:VmStateIsRunningConverter x:Key="VmStateIsRunningConverter" />
  <conv:NonZeroCountToVisibilityConverter x:Key="NonZeroCountToVisibilityConverter" />
  <conv:StringEqualConverter x:Key="StringEqualConverter" />
  <conv:FilterActiveBrushConverter x:Key="FilterBgConverter"
    ActiveBrush="{StaticResource AccentLightBrush}"
    InactiveBrush="{StaticResource SubtleBrush}" />
  <conv:FilterActiveBrushConverter x:Key="FilterFgConverter"
    ActiveBrush="{StaticResource AccentBrush}"
    InactiveBrush="{StaticResource MutedBrush}" />
</ResourceDictionary>
