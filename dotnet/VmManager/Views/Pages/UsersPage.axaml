<UserControl
  x:Class="VmManager.Views.Pages.UsersPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  x:DataType="vm:UsersViewModel"
  mc:Ignorable="d"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,16" MaxWidth="750">
      <TextBlock Text="User Management" Classes="heading-large" Margin="0,0,0,20" />

      <!-- Status Notification -->
      <Border
        CornerRadius="6"
        Padding="12,8"
        Margin="0,0,0,12"
        IsVisible="{Binding ShowStatus}"
      >
        <Border.Background>
          <MultiBinding Converter="{x:Static BoolConverters.Or}">
            <Binding Path="IsError" />
          </MultiBinding>
        </Border.Background>
        <Panel>
          <Border CornerRadius="6" Padding="12,8" Background="#C8102E" IsVisible="{Binding IsError}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap" FontSize="13" />
          </Border>
          <Border CornerRadius="6" Padding="12,8" Background="#107C10" IsVisible="{Binding !IsError}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap" FontSize="13" />
          </Border>
        </Panel>
      </Border>

      <!-- User List Header -->
      <DockPanel Margin="0,0,0,8">
        <TextBlock Text="Users" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        <Button
          Content="+ New User"
          Command="{Binding EnterCreateModeCommand}"
          DockPanel.Dock="Right"
          HorizontalAlignment="Right"
          Padding="12,6"
        />
      </DockPanel>

      <!-- User List -->
      <Border
        Background="{DynamicResource CardBrush}"
        CornerRadius="6"
        Padding="4"
        Margin="0,0,0,16"
      >
        <ItemsControl ItemsSource="{Binding Users}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Padding="10,8"
                Click="UserItem_Click"
                Tag="{Binding}"
              >
                <DockPanel>
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button
                      Content="Reset Password"
                      Click="ResetPassword_Click"
                      Tag="{Binding}"
                      Padding="8,4"
                      FontSize="11"
                      Margin="0,0,6,0"
                    />
                    <Button
                      Content="Delete"
                      Click="DeleteUser_Click"
                      Tag="{Binding}"
                      Background="#C8102E"
                      Foreground="White"
                      Padding="8,4"
                      FontSize="11"
                      IsVisible="{Binding !IsAdmin}"
                    />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="People" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Username}" VerticalAlignment="Center" FontSize="13" />
                    <Border
                      Background="{DynamicResource AccentBrush}"
                      CornerRadius="3"
                      Padding="6,2"
                      Margin="8,0,0,0"
                      IsVisible="{Binding IsAdmin}"
                      VerticalAlignment="Center"
                    >
                      <TextBlock Text="Admin" FontSize="11" Foreground="White" />
                    </Border>
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Reset Password Inline -->
      <Border
        Background="{DynamicResource CardBrush}"
        CornerRadius="6"
        Padding="16,12"
        Margin="0,0,0,16"
        IsVisible="{Binding ShowResetPassword}"
      >
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="New password:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" />
          <TextBox Watermark="Enter new password" PasswordChar="*" Text="{Binding ResetPasswordText}" Width="220" />
          <Button Content="Confirm Reset" Command="{Binding ResetPasswordCommand}" Margin="8,0,0,0" Padding="12,6" />
          <Button Content="Cancel" Command="{Binding ToggleResetPasswordCommand}" Margin="6,0,0,0" Padding="12,6" Background="Transparent" />
        </StackPanel>
      </Border>

      <!-- Delete Confirmation -->
      <Border
        Background="{DynamicResource CardBrush}"
        CornerRadius="6"
        Padding="16,12"
        Margin="0,0,0,16"
        IsVisible="{Binding ShowDeleteConfirmation}"
      >
        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13">
            <TextBlock.Text>
              <MultiBinding StringFormat="Delete user '{0}'?">
                <Binding Path="SelectedUser.Username" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <Button Content="Confirm Delete" Command="{Binding ConfirmDeleteUserCommand}" Background="#C8102E" Foreground="White" Padding="12,6" />
          <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" Margin="6,0,0,0" Padding="12,6" Background="Transparent" />
        </StackPanel>
      </Border>

      <!-- Create Mode -->
      <StackPanel IsVisible="{Binding IsCreateMode}">
        <TextBlock Text="Create New User" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
        <Border
          Background="{DynamicResource CardBrush}"
          CornerRadius="6"
          Padding="16"
          Margin="0,0,0,16"
        >
          <StackPanel>
            <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,8">
              <TextBox Grid.Column="0" Watermark="Username" Text="{Binding NewUsername}" />
              <TextBox Grid.Column="2" Watermark="Password" PasswordChar="*" Text="{Binding NewPassword}" />
            </Grid>
            <CheckBox Content="Admin" IsChecked="{Binding EditIsAdmin}" Margin="0,0,0,8" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PermissionCheckboxes}" />

            <Button
              Content="Create User"
              Command="{Binding CreateUserCommand}"
              HorizontalAlignment="Left"
              Padding="16,8"
              Margin="0,8,0,0"
            />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Edit Mode (non-admin users only) -->
      <StackPanel IsVisible="{Binding IsEditMode}">
        <TextBlock Text="Edit User" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
        <Border
          Background="{DynamicResource CardBrush}"
          CornerRadius="6"
          Padding="16"
          Margin="0,0,0,16"
        >
          <StackPanel>
            <TextBox Watermark="Username" Text="{Binding EditUsername}" Margin="0,0,0,8" MaxWidth="300" HorizontalAlignment="Left" />
            <CheckBox Content="Admin" IsChecked="{Binding EditIsAdmin}" Margin="0,0,0,8" />

            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PermissionCheckboxes}" />

            <Button
              Content="Save"
              Command="{Binding SaveUserCommand}"
              HorizontalAlignment="Left"
              Padding="16,8"
              Margin="0,8,0,0"
            />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>

  <UserControl.Resources>
    <DataTemplate x:Key="PermissionCheckboxes" x:DataType="vm:UsersViewModel">
      <StackPanel>
        <TextBlock Text="Permissions" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,8" />

        <TextBlock Text="VM Operations" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
        <WrapPanel Margin="0,0,0,8">
          <CheckBox Content="Create" IsChecked="{Binding PermVmCreate}" Margin="0,0,12,0" />
          <CheckBox Content="Delete" IsChecked="{Binding PermVmDelete}" Margin="0,0,12,0" />
          <CheckBox Content="Start" IsChecked="{Binding PermVmStart}" Margin="0,0,12,0" />
          <CheckBox Content="Stop" IsChecked="{Binding PermVmStop}" Margin="0,0,12,0" />
          <CheckBox Content="Rename" IsChecked="{Binding PermVmRename}" Margin="0,0,12,0" />
          <CheckBox Content="Reset" IsChecked="{Binding PermVmReset}" Margin="0,0,12,0" />
          <CheckBox Content="Apply Locale" IsChecked="{Binding PermVmApplyLocale}" Margin="0,0,12,0" />
          <CheckBox Content="View All VMs" IsChecked="{Binding PermVmViewAll}" Margin="0,0,12,0" />
        </WrapPanel>

        <TextBlock Text="Snapshots" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
        <WrapPanel Margin="0,0,0,8">
          <CheckBox Content="Create" IsChecked="{Binding PermSnapshotCreate}" Margin="0,0,12,0" />
          <CheckBox Content="Restore" IsChecked="{Binding PermSnapshotRestore}" Margin="0,0,12,0" />
          <CheckBox Content="Delete" IsChecked="{Binding PermSnapshotDelete}" Margin="0,0,12,0" />
          <CheckBox Content="Clone" IsChecked="{Binding PermSnapshotClone}" Margin="0,0,12,0" />
          <CheckBox Content="Push" IsChecked="{Binding PermSnapshotPush}" Margin="0,0,12,0" />
        </WrapPanel>

        <TextBlock Text="Marketplace" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
        <WrapPanel Margin="0,0,0,8">
          <CheckBox Content="Browse" IsChecked="{Binding PermCatalogBrowse}" Margin="0,0,12,0" />
          <CheckBox Content="Import" IsChecked="{Binding PermCatalogImport}" Margin="0,0,12,0" />
          <CheckBox Content="Delete Local" IsChecked="{Binding PermCatalogDeleteLocal}" Margin="0,0,12,0" />
        </WrapPanel>

        <TextBlock Text="Settings" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
        <WrapPanel Margin="0,0,0,8">
          <CheckBox Content="View" IsChecked="{Binding PermSettingsView}" Margin="0,0,12,0" />
          <CheckBox Content="Edit VM Defaults" IsChecked="{Binding PermSettingsEditVmDefaults}" Margin="0,0,12,0" />
          <CheckBox Content="Manage Feeds" IsChecked="{Binding PermSettingsManageFeeds}" Margin="0,0,12,0" />
          <CheckBox Content="Edit Scripts" IsChecked="{Binding PermSettingsEditScripts}" Margin="0,0,12,0" />
        </WrapPanel>

        <TextBlock Text="Other" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
        <WrapPanel Margin="0,0,0,8">
          <CheckBox Content="RDP Connect" IsChecked="{Binding PermRdpConnect}" Margin="0,0,12,0" />
          <CheckBox Content="Manage Users" IsChecked="{Binding PermUsersManage}" Margin="0,0,12,0" />
        </WrapPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
</UserControl>
