<UserControl
  x:Class="VmManager.Views.Pages.UsersPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  x:DataType="vm:UsersViewModel"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,32" MaxWidth="800">

      <!-- Header -->
      <DockPanel Margin="0,0,0,16">
        <TextBlock Text="Users" Classes="heading-large" VerticalAlignment="Center" />
        <Button
          DockPanel.Dock="Right"
          HorizontalAlignment="Right"
          Theme="{StaticResource FilledAccentButton}"
          Command="{Binding EnterCreateModeCommand}"
          Padding="14,7"
          Content="New User"
        />
      </DockPanel>

      <!-- Status -->
      <Border
        IsVisible="{Binding ShowStatus}"
        CornerRadius="{DynamicResource RoundMd}"
        Padding="12,8"
        Margin="0,0,0,12"
        Background="{Binding IsError, Converter={StaticResource BoolToStatusBrushConverter}}"
      >
        <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap" FontSize="13" />
      </Border>

      <!-- User List -->
      <Border Theme="{StaticResource CardStyle}" Padding="4">
        <ItemsControl ItemsSource="{Binding Users}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                Padding="12,10"
                Click="UserItem_Click"
                Tag="{Binding}"
                BorderThickness="0"
              >
                <DockPanel>
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Spacing="6">
                    <Button
                      Content="Invite"
                      Theme="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding $parent[UserControl].((vm:UsersViewModel)DataContext).SendInviteCommand}"
                      CommandParameter="{Binding}"
                      Padding="8,4" FontSize="11"
                      IsVisible="{Binding !IsAdmin}"
                    />
                    <Button
                      Content="Reset Password"
                      Click="ResetPassword_Click"
                      Tag="{Binding}"
                      Padding="8,4" FontSize="11"
                    />
                    <Button
                      Content="Delete"
                      Theme="{StaticResource DangerButtonStyle}"
                      Click="DeleteUser_Click"
                      Tag="{Binding}"
                      Padding="8,4" FontSize="11"
                      IsVisible="{Binding !IsAdmin}"
                    />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <ui:SymbolIcon Symbol="People" FontSize="14" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding Username}" Classes="body" VerticalAlignment="Center" />
                    <Border
                      Theme="{StaticResource StateBadgeStyle}"
                      Background="{DynamicResource AccentBrush}"
                      IsVisible="{Binding IsAdmin}"
                    >
                      <TextBlock Text="Admin" FontSize="10" Foreground="White" FontWeight="Medium" />
                    </Border>
                    <TextBlock Classes="caption" VerticalAlignment="Center">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="Max VMs: {0}">
                          <Binding Path="MaxVms" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- Reset Password -->
      <Border Theme="{StaticResource CardStyle}" IsVisible="{Binding ShowResetPassword}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="New password:" VerticalAlignment="Center" Classes="body" />
          <TextBox Watermark="Enter new password" PasswordChar="*" Text="{Binding ResetPasswordText}" Width="220" />
          <Button Content="Confirm" Theme="{StaticResource FilledAccentButton}" Command="{Binding ResetPasswordCommand}" Padding="12,7" />
          <Button Content="Cancel" Command="{Binding ToggleResetPasswordCommand}" Padding="12,7" Background="Transparent" />
        </StackPanel>
      </Border>

      <!-- Delete Confirmation -->
      <Border Theme="{StaticResource CardStyle}" IsVisible="{Binding ShowDeleteConfirmation}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock VerticalAlignment="Center" Classes="body">
            <TextBlock.Text>
              <MultiBinding StringFormat="Delete user '{0}'?">
                <Binding Path="SelectedUser.Username" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
          <Button Content="Delete" Theme="{StaticResource DangerButtonStyle}" Command="{Binding ConfirmDeleteUserCommand}" Padding="12,7" />
          <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" Padding="12,7" Background="Transparent" />
        </StackPanel>
      </Border>

      <!-- Create Mode -->
      <StackPanel IsVisible="{Binding IsCreateMode}">
        <TextBlock Text="Create New User" Classes="subtitle" Margin="0,8,0,12" />
        <Border Theme="{StaticResource CardStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,16,*">
              <TextBox Grid.Column="0" Watermark="Email (login)" Text="{Binding NewUsername}" />
              <TextBox Grid.Column="2" Watermark="Password" PasswordChar="*" Text="{Binding NewPassword}" />
            </Grid>
            <CheckBox Content="Admin" IsChecked="{Binding EditIsAdmin}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PermissionCheckboxes}" />
            <Button
              Content="Create User"
              Theme="{StaticResource FilledAccentButton}"
              Command="{Binding CreateUserCommand}"
              HorizontalAlignment="Left"
              Padding="16,8"
            />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Edit Mode -->
      <StackPanel IsVisible="{Binding IsEditMode}">
        <TextBlock Text="Edit User" Classes="subtitle" Margin="0,8,0,12" />
        <Border Theme="{StaticResource CardStyle}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,16,Auto">
              <TextBox Grid.Column="0" Watermark="Email (login)" Text="{Binding EditUsername}" MaxWidth="340" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="2" Width="140">
                <TextBlock Text="Max VMs" Classes="caption" Margin="0,0,0,4" />
                <NumericUpDown Value="{Binding EditMaxVms}" Minimum="-1" FormatString="0" />
              </StackPanel>
            </Grid>
            <TextBlock Text="-1 = unlimited, 0 = use global default" Classes="caption" />
            <CheckBox Content="Admin" IsChecked="{Binding EditIsAdmin}" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PermissionCheckboxes}" />
            <Button
              Content="Save"
              Theme="{StaticResource FilledAccentButton}"
              Command="{Binding SaveUserCommand}"
              HorizontalAlignment="Left"
              Padding="16,8"
            />
          </StackPanel>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

  <UserControl.Resources>
    <DataTemplate x:Key="PermissionCheckboxes" x:DataType="vm:UsersViewModel">
      <StackPanel Spacing="8">
        <TextBlock Text="Permissions" Classes="subtitle" Margin="0,4,0,0" />

        <TextBlock Text="VM Operations" Classes="caption" />
        <WrapPanel>
          <CheckBox Content="Create" IsChecked="{Binding PermVmCreate}" Margin="0,0,16,0" />
          <CheckBox Content="Delete" IsChecked="{Binding PermVmDelete}" Margin="0,0,16,0" />
          <CheckBox Content="Start" IsChecked="{Binding PermVmStart}" Margin="0,0,16,0" />
          <CheckBox Content="Stop" IsChecked="{Binding PermVmStop}" Margin="0,0,16,0" />
          <CheckBox Content="Rename" IsChecked="{Binding PermVmRename}" Margin="0,0,16,0" />
          <CheckBox Content="Reset" IsChecked="{Binding PermVmReset}" Margin="0,0,16,0" />
          <CheckBox Content="Apply Locale" IsChecked="{Binding PermVmApplyLocale}" Margin="0,0,16,0" />
          <CheckBox Content="View All" IsChecked="{Binding PermVmViewAll}" Margin="0,0,16,0" />
        </WrapPanel>

        <TextBlock Text="Snapshots" Classes="caption" />
        <WrapPanel>
          <CheckBox Content="Create" IsChecked="{Binding PermSnapshotCreate}" Margin="0,0,16,0" />
          <CheckBox Content="Restore" IsChecked="{Binding PermSnapshotRestore}" Margin="0,0,16,0" />
          <CheckBox Content="Delete" IsChecked="{Binding PermSnapshotDelete}" Margin="0,0,16,0" />
          <CheckBox Content="Clone" IsChecked="{Binding PermSnapshotClone}" Margin="0,0,16,0" />
          <CheckBox Content="Push" IsChecked="{Binding PermSnapshotPush}" Margin="0,0,16,0" />
        </WrapPanel>

        <TextBlock Text="Marketplace" Classes="caption" />
        <WrapPanel>
          <CheckBox Content="Browse" IsChecked="{Binding PermCatalogBrowse}" Margin="0,0,16,0" />
          <CheckBox Content="Import" IsChecked="{Binding PermCatalogImport}" Margin="0,0,16,0" />
          <CheckBox Content="Delete Local" IsChecked="{Binding PermCatalogDeleteLocal}" Margin="0,0,16,0" />
        </WrapPanel>

        <TextBlock Text="Settings" Classes="caption" />
        <WrapPanel>
          <CheckBox Content="View" IsChecked="{Binding PermSettingsView}" Margin="0,0,16,0" />
          <CheckBox Content="Edit Defaults" IsChecked="{Binding PermSettingsEditVmDefaults}" Margin="0,0,16,0" />
          <CheckBox Content="Manage Feeds" IsChecked="{Binding PermSettingsManageFeeds}" Margin="0,0,16,0" />
          <CheckBox Content="Edit Scripts" IsChecked="{Binding PermSettingsEditScripts}" Margin="0,0,16,0" />
        </WrapPanel>

        <TextBlock Text="Other" Classes="caption" />
        <WrapPanel>
          <CheckBox Content="RDP Connect" IsChecked="{Binding PermRdpConnect}" Margin="0,0,16,0" />
          <CheckBox Content="Manage Users" IsChecked="{Binding PermUsersManage}" Margin="0,0,16,0" />
        </WrapPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
</UserControl>
