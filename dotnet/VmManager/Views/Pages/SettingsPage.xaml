<Page
  x:Class="VmManager.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="Settings"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24,16,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Page header -->
      <TextBlock
        Grid.Row="0"
        Text="Settings"
        Style="{StaticResource TitleTextBlockStyle}"
        Margin="0,0,0,24"
      />

      <!-- Status bar -->
      <Border
        Grid.Row="1"
        x:Name="StatusBar"
        CornerRadius="5"
        Padding="12,8"
        Margin="0,0,0,16"
        Visibility="Collapsed"
      >
        <DockPanel>
          <Button
            DockPanel.Dock="Right"
            Content="📋"
            ToolTip="Copy to clipboard"
            Click="CopyStatus_Click"
            Background="Transparent"
            Foreground="White"
            Padding="8,4"
            VerticalAlignment="Center"
          />
          <TextBox
            x:Name="StatusText"
            IsReadOnly="True"
            Background="Transparent"
            BorderThickness="0"
            Foreground="White"
            TextWrapping="Wrap"
            Padding="0"
            FontSize="13"
            VerticalAlignment="Center"
          />
        </DockPanel>
      </Border>

      <!-- Registry card -->
      <Border Grid.Row="2" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="OCI Registry" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
          <TextBlock
            Text="Connect to your Zot registry to browse and pull VM images."
            Opacity="0.6"
            FontSize="12"
            Margin="0,0,0,16"
          />

          <TextBlock Text="Registry URL" Margin="0,0,0,4" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              Grid.Column="0"
              x:Name="RegistryUrlBox"
              Margin="0,0,8,0"
              ToolTip="e.g. http://10.5.1.15:5000"
            />
            <Button
              Grid.Column="1"
              x:Name="LoadReposButton"
              Content="Load Repos"
              Click="LoadRepos_Click"
              Style="{StaticResource PrimaryButtonStyle}"
            />
          </Grid>

          <TextBlock Text="Repository" Margin="0,0,0,4" />
          <ComboBox
            x:Name="RegistryRepoCombo"
            Margin="0,0,0,4"
            IsEditable="True"
            ToolTip="Select a repository or type one"
          />
          <TextBlock
            x:Name="RepoStatusText"
            Foreground="{DynamicResource MutedBrush}"
            FontSize="11"
            Margin="0,0,0,12"
          />
        </StackPanel>
      </Border>

      <!-- Local catalog card -->
      <Border Grid.Row="3" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock
            Text="Local Image Source"
            FontWeight="SemiBold"
            FontSize="14"
            Margin="0,0,0,4"
          />
          <TextBlock
            Text="Path to a folder containing catalog.json and .box files. Works alongside the registry."
            Opacity="0.6"
            FontSize="12"
            Margin="0,0,0,12"
          />

          <TextBlock Text="Local Catalog Path (optional)" Margin="0,0,0,4" />
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="LocalCatalogPathBox"
              Grid.Column="0"
              Margin="0,0,8,0"
              ToolTip="UNC path or local folder with catalog.json (e.g. \\server\vms or C:\VMs\catalog)"
            />
            <Button Grid.Column="1" Content="Browse…" Click="BrowseLocalCatalogPath_Click" />
          </Grid>

          <TextBlock Text="Local VMs Folder" Margin="0,0,0,4" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LocalVmPathTextBox" Grid.Column="0" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Browse…" Click="BrowseLocalVmPath_Click" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Nexus card -->
      <Border Grid.Row="4" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock
            Text="Nexus Repository (Linux Images)"
            FontWeight="SemiBold"
            FontSize="14"
            Margin="0,0,0,4"
          />
          <TextBlock
            Text="Connect to a Nexus raw repository to browse Linux container images."
            Opacity="0.6"
            FontSize="12"
            Margin="0,0,0,16"
          />

          <TextBlock Text="Nexus URL" Margin="0,0,0,4" />
          <TextBox
            x:Name="NexusUrlBox"
            Margin="0,0,0,12"
            ToolTip="e.g. https://nexus.example.com"
          />

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Username" Margin="0,0,0,4" />
              <TextBox x:Name="NexusUsernameBox" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="Password" Margin="0,0,0,4" />
              <TextBox x:Name="NexusPasswordBox" />
            </StackPanel>
          </Grid>

          <TextBlock Text="Repository Name" Margin="0,0,0,4" />
          <TextBox x:Name="NexusRepoBox" Margin="0,0,0,4" ToolTip="e.g. Release_LinuxImages" />
        </StackPanel>
      </Border>

      <!-- VM credentials + defaults card -->
      <Border Grid.Row="5" Style="{StaticResource CardStyle}">
        <StackPanel>
          <TextBlock Text="VM Defaults" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16" />

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Memory (MB)" Margin="0,0,0,4" />
              <TextBox x:Name="MemoryMbBox" ToolTip="e.g. 4096" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="CPU Count" Margin="0,0,0,4" />
              <TextBox x:Name="CpuCountBox" ToolTip="e.g. 4" />
            </StackPanel>

            <StackPanel Grid.Column="4">
              <TextBlock Text="Username" Margin="0,0,0,4" />
              <TextBox x:Name="UsernameBox" />
            </StackPanel>

            <StackPanel Grid.Column="6">
              <TextBlock Text="Password" Margin="0,0,0,4" />
              <TextBox x:Name="PasswordBox" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Save button -->
      <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,4,0,0">
        <Button
          Content="Save Settings"
          Style="{StaticResource PrimaryButtonStyle}"
          Padding="24,10"
          FontSize="14"
          Click="SaveButton_Click"
        />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
