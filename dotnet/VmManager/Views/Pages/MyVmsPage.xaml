<Page
  x:Class="VmManager.Views.Pages.MyVmsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  xmlns:models="clr-namespace:VmManager.Models"
  d:DataContext="{d:DesignInstance Type=vm:MyVmsViewModel}"
  mc:Ignorable="d"
  Title="My VMs"
>
  <Page.Resources>
    <CollectionViewSource x:Key="GroupedVms" Source="{Binding Vms}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="GroupKey" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Page.Resources>

  <Grid Margin="24,16,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Page header -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock
        Grid.Column="0"
        Text="My VMs"
        Style="{StaticResource TitleTextBlockStyle}"
        VerticalAlignment="Center"
      />

      <Button
        Grid.Column="1"
        Content="↻  Refresh"
        Command="{Binding RefreshCommand}"
        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
      />
    </Grid>

    <!-- Hyper-V unavailable warning -->
    <Border
      Grid.Row="1"
      Background="#7A4B00"
      CornerRadius="5"
      Padding="12,8"
      Margin="0,0,0,12"
      Visibility="{Binding HyperVUnavailable, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <TextBlock
        Text="Hyper-V is not available on this machine. Enable the Hyper-V feature in Windows Features and restart."
        Foreground="White"
        TextWrapping="Wrap"
      />
    </Border>

    <!-- Status bar -->
    <Border
      Grid.Row="2"
      Background="{Binding IsError, Converter={StaticResource BoolToStatusBrushConverter}}"
      CornerRadius="5"
      Padding="12,8"
      Margin="0,0,0,12"
      Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <DockPanel>
        <Button
          DockPanel.Dock="Right"
          Content="📋"
          ToolTip="Copy to clipboard"
          Click="CopyStatus_Click"
          Background="Transparent"
          Foreground="White"
          Padding="8,4"
          VerticalAlignment="Center"
        />
        <TextBox
          Text="{Binding StatusMessage, Mode=OneWay}"
          IsReadOnly="True"
          Background="Transparent"
          BorderThickness="0"
          Foreground="White"
          TextWrapping="Wrap"
          Padding="0"
          FontSize="13"
          VerticalAlignment="Center"
        />
      </DockPanel>
    </Border>

    <!-- Loading indicator -->
    <StackPanel
      Grid.Row="3"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
      <TextBlock Text="Loading VMs…" Margin="0,12,0,0" HorizontalAlignment="Center" Opacity="0.7" />
    </StackPanel>

    <!-- VM cards (grouped by backend) -->
    <ScrollViewer
      Grid.Row="3"
      VerticalScrollBarVisibility="Auto"
      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
    >
      <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedVms}}">
        <ItemsControl.GroupStyle>
          <GroupStyle>
            <GroupStyle.ContainerStyle>
              <Style TargetType="GroupItem">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                      <Expander
                        IsExpanded="{Binding Name, Converter={StaticResource BackendToExpandedConverter}, Mode=OneTime}"
                        Margin="0,0,0,8"
                      >
                        <Expander.Header>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock
                              Text="{Binding Name, Converter={StaticResource BackendDisplayNameConverter}}"
                              FontSize="16"
                              FontWeight="SemiBold"
                            />
                            <TextBlock
                              Text="{Binding ItemCount, StringFormat=' ({0})'}"
                              FontSize="14"
                              Opacity="0.5"
                              VerticalAlignment="Center"
                            />
                          </StackPanel>
                        </Expander.Header>
                        <ItemsPresenter Margin="0,8,0,0" />
                      </Expander>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </GroupStyle.ContainerStyle>
          </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type models:VmInstance}">
            <Border Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- VM info -->
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock
                      Text="{Binding Name}"
                      FontSize="15"
                      FontWeight="SemiBold"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"
                    />
                    <Border
                      CornerRadius="4"
                      Padding="8,2"
                      VerticalAlignment="Center"
                      Background="{Binding State, Converter={StaticResource VmStateToBrushConverter}}"
                    >
                      <TextBlock
                        Text="{Binding State}"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="White"
                      />
                    </Border>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal">
                    <TextBlock
                      Text="{Binding MemoryDisplay}"
                      Style="{StaticResource MutedTextStyle}"
                      Margin="0,0,16,0"
                    />
                    <TextBlock
                      Text="{Binding Uptime, StringFormat='Uptime: {0:hh\\:mm\\:ss}'}"
                      Style="{StaticResource MutedTextStyle}"
                    />
                  </StackPanel>
                </StackPanel>

                <!-- Notes -->
                <TextBox
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,8,0,0"
                  FontSize="12"
                  Opacity="0.85"
                  ToolTip="Add notes about this VM"
                  LostFocus="NoteBox_LostFocus"
                  AcceptsReturn="False"
                  Background="#FAFAFA"
                  BorderBrush="{DynamicResource DividerBrush}"
                >
                  <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                      <Setter Property="Background" Value="#FAFAFA" />
                    </Style>
                  </TextBox.Style>
                </TextBox>

                <!-- Actions -->
                <StackPanel
                  Grid.Row="0"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                >
                  <Button
                    Content="▶  Start"
                    Margin="0,0,6,0"
                    Command="{Binding DataContext.StartVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                  />

                  <Button
                    Content="⏹  Stop"
                    Margin="0,0,6,0"
                    Command="{Binding DataContext.StopVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                  />

                  <Button
                    Content="🖥  Connect"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,6,0"
                    ToolTip="{Binding DataContext.CredentialTooltip, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    Command="{Binding DataContext.ConnectVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                  />

                  <Button
                    Content="📸"
                    Margin="0,0,6,0"
                    ToolTip="Take a quick snapshot (auto-named with timestamp)"
                    Visibility="{Binding Backend, Converter={StaticResource IsNotDockerToVisibilityConverter}}"
                    Command="{Binding DataContext.QuickSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                  />

                  <Button
                    Content="↺  Reset"
                    Margin="0,0,6,0"
                    ToolTip="Restore this VM to its oldest snapshot"
                    Visibility="{Binding Backend, Converter={StaticResource IsNotDockerToVisibilityConverter}}"
                    Command="{Binding DataContext.ResetVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                  />

                  <Button
                    Content="✏"
                    Margin="0,0,6,0"
                    ToolTip="Rename this VM"
                    Click="RenameButton_Click"
                    Tag="{Binding}"
                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                  />

                  <Button
                    Content="🗑"
                    Style="{StaticResource DangerButtonStyle}"
                    ToolTip="Permanently delete this VM"
                    Command="{Binding DataContext.DeleteVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                  />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Empty state -->
    <StackPanel
      Grid.Row="3"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Visibility="{Binding Vms.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"
    >
      <TextBlock Text="🖥" FontSize="48" Opacity="0.35" HorizontalAlignment="Center" />
      <TextBlock
        Text="No virtual machines found"
        FontSize="16"
        Opacity="0.5"
        Margin="0,12,0,4"
        HorizontalAlignment="Center"
      />
      <TextBlock
        Text="Import an image from the Images page to get started."
        Foreground="{DynamicResource MutedBrush}"
        HorizontalAlignment="Center"
      />
    </StackPanel>

    <!-- Default credentials footer -->
    <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
          Grid.Column="0"
          Text="Default credentials"
          FontSize="12"
          FontWeight="SemiBold"
          Opacity="0.55"
          VerticalAlignment="Center"
          Margin="0,0,20,0"
        />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <!-- Username -->
          <TextBlock
            Text="User:"
            FontSize="12"
            Opacity="0.55"
            VerticalAlignment="Center"
            Margin="0,0,6,0"
          />
          <TextBlock
            Text="{Binding DefaultUsername}"
            FontSize="12"
            FontFamily="Consolas"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Margin="0,0,4,0"
          />
          <Button
            Content="📋"
            FontSize="11"
            Padding="5,2"
            Margin="0,0,20,0"
            ToolTip="Copy username"
            Tag="{Binding DefaultUsername}"
            Click="CopyCredential_Click"
            Background="Transparent"
          />

          <!-- Password -->
          <TextBlock
            Text="Password:"
            FontSize="12"
            Opacity="0.55"
            VerticalAlignment="Center"
            Margin="0,0,6,0"
          />
          <TextBlock
            Text="{Binding DefaultPassword}"
            FontSize="12"
            FontFamily="Consolas"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Margin="0,0,4,0"
          />
          <Button
            Content="📋"
            FontSize="11"
            Padding="5,2"
            ToolTip="Copy password"
            Tag="{Binding DefaultPassword}"
            Click="CopyCredential_Click"
            Background="Transparent"
          />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
