<UserControl
  x:Class="VmManager.Views.Pages.MyVmsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:props="clr-namespace:VmManager.Properties"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  xmlns:ctrl="clr-namespace:VmManager.Views.Controls"
  x:DataType="vm:MyVmsViewModel"
>
  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="32,28,32,0">
      <TextBlock Text="My Virtual Machines" Classes="heading-large" VerticalAlignment="Center" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
        <TextBox
          Watermark="Search..."
          Text="{Binding SearchQuery}"
          Width="220"
          Padding="10,7"
          FontSize="13"
        />
        <Button Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" Padding="9,7" Background="Transparent" BorderThickness="0">
          <ui:SymbolIcon Symbol="Refresh" FontSize="16" Foreground="{DynamicResource MutedBrush}" />
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Filter Bar -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="32,16,32,8" Spacing="6">
      <Border CornerRadius="16" Padding="12,5" Cursor="Hand" Background="{DynamicResource AccentLightBrush}" PointerPressed="FilterAll_Click">
        <TextBlock x:Name="FilterAll" Text="All" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
      </Border>
      <Border x:Name="FilterRunningBorder" CornerRadius="16" Padding="12,5" Cursor="Hand" Background="{DynamicResource SubtleBrush}" PointerPressed="FilterRunning_Click">
        <TextBlock x:Name="FilterRunning" Text="Running" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
      </Border>
      <Border x:Name="FilterStoppedBorder" CornerRadius="16" Padding="12,5" Cursor="Hand" Background="{DynamicResource SubtleBrush}" PointerPressed="FilterStopped_Click">
        <TextBlock x:Name="FilterStopped" Text="Stopped" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
      </Border>
    </StackPanel>

    <!-- Content -->
    <Panel Grid.Row="2">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" />

      <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsLoading}">
        <StackPanel Margin="32,0,32,32">

          <!-- Backend unavailable -->
          <Border
            IsVisible="{Binding BackendUnavailable}"
            CornerRadius="{DynamicResource RoundMd}"
            Padding="12,8"
            Margin="0,0,0,12"
            Background="{DynamicResource ErrorBrush}"
          >
            <TextBlock Text="Backend unavailable. Check your hypervisor configuration." Foreground="White" TextWrapping="Wrap" FontSize="13" />
          </Border>

          <!-- Status message -->
          <Border
            IsVisible="{Binding ShowStatus}"
            CornerRadius="{DynamicResource RoundMd}"
            Padding="12,8"
            Margin="0,0,0,12"
          >
            <Border.Background>
              <Binding Path="IsError">
                <Binding.Converter>
                  <StaticResource ResourceKey="BoolToStatusBrushConverter" />
                </Binding.Converter>
              </Binding>
            </Border.Background>
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap" FontSize="13" />
          </Border>

          <!-- Shared VMs -->
          <StackPanel IsVisible="{Binding HasSharedVms}">
            <TextBlock Text="Shared with me" Classes="subtitle" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding SharedVms}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:VmInstanceViewModel">
                  <ctrl:VmCard Tag="{Binding $parent[UserControl].DataContext}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Grouped VMs -->
          <ItemsControl ItemsSource="{Binding GroupedVms}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:VmGroup">
                <StackPanel Margin="0,0,0,8">
                  <TextBlock Text="{Binding Name}" Classes="subtitle" Margin="0,8,0,8" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:VmInstanceViewModel">
                        <StackPanel>
                          <ctrl:VmCard Tag="{Binding $parent[UserControl].DataContext}" />

                          <!-- Detail Panel (expanded when selected) -->
                          <Border
                            IsVisible="{Binding IsExpanded}"
                            Background="White"
                            CornerRadius="{DynamicResource RoundLg}"
                            Padding="20"
                            Margin="0,0,0,8"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                          >
                            <StackPanel Spacing="12">

                              <!-- Notes -->
                              <StackPanel>
                                <TextBlock Text="Notes" Classes="caption-strong" Margin="0,0,0,4" />
                                <TextBox
                                  Text="{Binding Notes}"
                                  AcceptsReturn="True"
                                  TextWrapping="Wrap"
                                  MinHeight="50"
                                  MaxHeight="120"
                                  Watermark="Add notes..."
                                  LostFocus="Notes_LostFocus"
                                />
                              </StackPanel>

                              <!-- Snapshots -->
                              <StackPanel IsVisible="{Binding ShowSnapshots}">
                                <DockPanel Margin="0,0,0,6">
                                  <TextBlock Text="Snapshots" Classes="caption-strong" VerticalAlignment="Center" />
                                  <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Theme="{StaticResource PrimaryButtonStyle}"
                                    Padding="10,5" FontSize="11"
                                    Command="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).ResetToBaseCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding State, Converter={StaticResource VmStateIsOffConverter}}"
                                    Content="Reset to Base"
                                  />
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Snapshots}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Padding="10,8" Margin="0,0,0,3" CornerRadius="6" Background="{DynamicResource SubtleBrush}">
                                        <DockPanel>
                                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Padding="6,3" FontSize="11" ToolTip.Tip="Restore"
                                              Command="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).RestoreSnapshotCommand}"
                                              CommandParameter="{Binding}">
                                              <ui:SymbolIcon Symbol="Refresh" FontSize="11" />
                                            </Button>
                                            <Button Padding="6,3" FontSize="11" ToolTip.Tip="Clone"
                                              Command="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).CloneFromSnapshotCommand}"
                                              CommandParameter="{Binding}">
                                              <ui:SymbolIcon Symbol="Copy" FontSize="11" />
                                            </Button>
                                            <Button Padding="6,3" FontSize="11" ToolTip.Tip="Push"
                                              Command="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).PushSnapshotCommand}"
                                              CommandParameter="{Binding}"
                                              IsVisible="{Binding IsNotBase}">
                                              <ui:SymbolIcon Symbol="Upload" FontSize="11" />
                                            </Button>
                                            <Button Padding="6,3" FontSize="11" ToolTip.Tip="Delete"
                                              Theme="{StaticResource DangerButtonStyle}"
                                              Command="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).DeleteSnapshotCommand}"
                                              CommandParameter="{Binding}"
                                              IsVisible="{Binding IsNotBase}">
                                              <ui:SymbolIcon Symbol="Delete" FontSize="11" />
                                            </Button>
                                          </StackPanel>
                                          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CreationTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Classes="caption" />
                                          </StackPanel>
                                        </DockPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Push progress -->
                                <Border
                                  IsVisible="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).IsPushing}"
                                  Padding="10,8" Margin="0,4,0,0" CornerRadius="6" Background="{DynamicResource SubtleBrush}"
                                >
                                  <StackPanel Spacing="4">
                                    <ProgressBar
                                      Value="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).PushProgress}"
                                      Maximum="1"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Text="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).PushStatusText}" Classes="caption" />
                                      <TextBlock Text="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).PushSpeedText}" Classes="caption" />
                                    </StackPanel>
                                  </StackPanel>
                                </Border>

                                <!-- Create snapshot -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                  <TextBox
                                    Text="{Binding NewSnapshotName}"
                                    Watermark="Snapshot name"
                                    Width="200"
                                    FontSize="12"
                                    Padding="8,5"
                                    IsEnabled="{Binding State, Converter={StaticResource VmStateIsOffConverter}}"
                                  />
                                  <Button
                                    Theme="{StaticResource FilledAccentButton}"
                                    Padding="10,5" FontSize="12"
                                    Command="{Binding $parent[UserControl].((vm:MyVmsViewModel)DataContext).CreateSnapshotForVmCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding State, Converter={StaticResource VmStateIsOffConverter}}"
                                    Content="Create"
                                  />
                                </StackPanel>
                              </StackPanel>

                              <!-- VM Info -->
                              <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Classes="caption">
                                  <Run Text="Backend: " /><Run Text="{Binding Backend, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Classes="caption">
                                  <Run Text="Memory: " /><Run Text="{Binding MemoryDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Classes="caption" IsVisible="{Binding OriginDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                  <Run Text="Image: " /><Run Text="{Binding OriginDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                              </StackPanel>

                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Troubleshoot -->
          <Button
            Content="Troubleshoot"
            Command="{Binding RunTroubleshootCommand}"
            IsVisible="{Binding BackendUnavailable}"
            Margin="0,8,0,0"
            Padding="10,6"
            FontSize="12"
          />
          <Border
            IsVisible="{Binding ShowTroubleshoot}"
            Theme="{StaticResource CardStyle}"
            Margin="0,8,0,0"
          >
            <TextBlock Text="{Binding TroubleshootReport}" TextWrapping="Wrap" FontSize="12" />
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Panel>
  </Grid>
</UserControl>
