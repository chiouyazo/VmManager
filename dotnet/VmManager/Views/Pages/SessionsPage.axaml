<UserControl
  x:Class="VmManager.Views.Pages.SessionsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  xmlns:models="clr-namespace:VmManager.Contracts.Models;assembly=VmManager.Contracts"
  x:DataType="vm:SessionsViewModel"
  x:CompileBindings="False"
>
  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <DockPanel Grid.Row="0" Margin="24,20,24,16">
      <TextBlock Text="Active Sessions" Classes="heading-large" VerticalAlignment="Center" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
        <Border
          Background="{DynamicResource TagBrush}"
          CornerRadius="10"
          Padding="10,4"
          IsVisible="{Binding SummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
        >
          <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{DynamicResource TagTextBrush}" />
        </Border>
        <Button Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" Padding="8,6">
          <ui:SymbolIcon Symbol="Refresh" FontSize="14" />
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Content -->
    <Panel Grid.Row="1">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" />

      <!-- Empty state -->
      <StackPanel
        IsVisible="{Binding !SessionCount}"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Spacing="8"
      >
        <ui:SymbolIcon Symbol="People" FontSize="40" Foreground="{DynamicResource HintBrush}" HorizontalAlignment="Center" />
        <TextBlock Text="No active sessions" Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Session groups -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsLoading}">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="24,0,24,24">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:VmSessionGroupViewModel">
              <Border Theme="{StaticResource CardStyle}" Margin="0,0,0,8">
                <StackPanel Spacing="12">

                  <!-- VM Header -->
                  <DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <ui:SymbolIcon Symbol="Important" FontSize="16" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock Text="{Binding VmName}" Classes="body-strong" VerticalAlignment="Center" />
                      <Border
                        Theme="{StaticResource StateBadgeStyle}"
                        Background="{Binding VmState, Converter={StaticResource VmStateToBrushConverter}}"
                      >
                        <TextBlock Text="{Binding VmState}" FontSize="11" Foreground="White" FontWeight="Medium" />
                      </Border>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right"
                      Background="{DynamicResource SubtleBrush}"
                      CornerRadius="10"
                      Padding="8,3"
                      VerticalAlignment="Center"
                    >
                      <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}">
                        <Run Text="{Binding Sessions.Count, Mode=OneWay}" />
                        <Run Text=" session(s)" />
                      </TextBlock>
                    </Border>
                  </DockPanel>

                  <!-- Session list -->
                  <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:ActiveSession">
                        <Border Padding="10,8" Margin="0,0,0,3" CornerRadius="6" Background="{DynamicResource SubtleBrush}">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                              <Button
                                Theme="{StaticResource PrimaryButtonStyle}"
                                Padding="8,4"
                                FontSize="11"
                                ToolTip.Tip="Shadow with consent prompt"
                                Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).ShadowCommand}"
                                CommandParameter="{Binding}"
                                Content="Shadow"
                              />
                              <Button
                                Padding="8,4"
                                FontSize="11"
                                ToolTip.Tip="Shadow without consent (force)"
                                Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).ShadowForceCommand}"
                                CommandParameter="{Binding}"
                                Content="Force"
                              />
                              <Button
                                Theme="{StaticResource DangerButtonStyle}"
                                Padding="8,4"
                                FontSize="11"
                                Command="{Binding $parent[UserControl].((vm:SessionsViewModel)DataContext).DisconnectCommand}"
                                CommandParameter="{Binding}"
                                Content="Disconnect"
                              />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <ui:SymbolIcon Symbol="People" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding Username}" FontSize="12" FontWeight="SemiBold" />
                              </StackPanel>
                              <TextBlock Classes="caption" VerticalAlignment="Center">
                                <Run Text="Connected " />
                                <Run Text="{Binding ConnectedAt, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock Classes="caption" VerticalAlignment="Center">
                                <Run Text="{Binding State, Mode=OneWay}" />
                              </TextBlock>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </Grid>
</UserControl>
