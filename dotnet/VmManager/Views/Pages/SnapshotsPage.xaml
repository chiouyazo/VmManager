<Page
  x:Class="VmManager.Views.Pages.SnapshotsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  xmlns:models="clr-namespace:VmManager.Models"
  d:DataContext="{d:DesignInstance Type=vm:SnapshotsViewModel}"
  mc:Ignorable="d"
  Title="Snapshots"
>
  <Grid Margin="24,16,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Page header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Snapshots" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock
        Text="Create, restore, and push VM snapshots"
        Foreground="{DynamicResource MutedBrush}"
        FontSize="13"
        Margin="0,4,0,0"
      />
    </StackPanel>

    <!-- Status bar -->
    <Border
      Grid.Row="1"
      Background="{Binding IsError, Converter={StaticResource BoolToStatusBrushConverter}}"
      CornerRadius="5"
      Padding="12,8"
      Margin="0,0,0,12"
      Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <DockPanel>
        <Button
          DockPanel.Dock="Right"
          Content="📋"
          ToolTip="Copy to clipboard"
          Click="CopyStatus_Click"
          Background="Transparent"
          Foreground="White"
          Padding="8,4"
          VerticalAlignment="Center"
        />
        <TextBox
          Text="{Binding StatusMessage, Mode=OneWay}"
          IsReadOnly="True"
          Background="Transparent"
          BorderThickness="0"
          Foreground="White"
          TextWrapping="Wrap"
          Padding="0"
          FontSize="13"
          VerticalAlignment="Center"
        />
      </DockPanel>
    </Border>

    <!-- VM selector + create snapshot -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox
          Grid.Column="0"
          ItemsSource="{Binding AvailableVms}"
          SelectedItem="{Binding SelectedVm}"
          DisplayMemberPath="Name"
          Margin="0,0,12,0"
        />

        <TextBox
          Grid.Column="1"
          Text="{Binding NewSnapshotName, UpdateSourceTrigger=PropertyChanged}"
          Width="200"
          Margin="0,0,8,0"
        />

        <Button
          Grid.Column="2"
          Content="＋  Create Snapshot"
          Style="{StaticResource PrimaryButtonStyle}"
          Margin="0,0,8,0"
          Command="{Binding CreateSnapshotCommand}"
          IsEnabled="{Binding HasSelectedVm}"
        />

        <Button Grid.Column="3" Content="↻" ToolTip="Refresh" Command="{Binding LoadVmsCommand}" />
      </Grid>
    </Border>

    <!-- Busy/progress indicator (above snapshot cards) -->
    <Border
      Grid.Row="3"
      Padding="0,0,0,8"
      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" />
        <TextBlock
          Text="{Binding BusyText}"
          Margin="0,6,0,0"
          Opacity="0.7"
          FontSize="12"
          HorizontalAlignment="Center"
        />
      </StackPanel>
    </Border>

    <!-- Upload/push indicator -->
    <Border
      Grid.Row="3"
      Padding="0,0,0,8"
      Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" />
        <TextBlock
          Text="Pushing snapshot…"
          Margin="0,6,0,0"
          Opacity="0.7"
          FontSize="12"
          HorizontalAlignment="Center"
        />
      </StackPanel>
    </Border>

    <!-- Snapshots list -->
    <ScrollViewer
      Grid.Row="4"
      VerticalScrollBarVisibility="Auto"
      Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}"
    >
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Snapshots}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:VmSnapshot}">
              <Border Style="{StaticResource CardStyle}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                      Text="{Binding Name}"
                      FontWeight="SemiBold"
                      FontSize="14"
                      Margin="0,0,0,4"
                    />
                    <TextBlock
                      Text="{Binding CreationTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                      Style="{StaticResource MutedTextStyle}"
                    />
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button
                      Content="↩  Restore"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Margin="0,0,8,0"
                      ToolTip="Revert the VM to this saved state (VM will be stopped)"
                      Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                    />

                    <Button
                      Content="⬆  Push"
                      Margin="0,0,8,0"
                      ToolTip="Push this snapshot to the OCI registry so others can use it"
                      Command="{Binding DataContext.PushSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding DataContext.IsUploading, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                    />

                    <Button
                      Content="🗑"
                      Style="{StaticResource DangerButtonStyle}"
                      ToolTip="Delete this snapshot"
                      Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolConverter}}"
                    />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state -->
        <StackPanel
          HorizontalAlignment="Center"
          Margin="0,48,0,0"
          Visibility="{Binding Snapshots.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"
        >
          <TextBlock Text="📸" FontSize="48" Opacity="0.35" HorizontalAlignment="Center" />
          <TextBlock
            Text="No snapshots"
            FontSize="16"
            Opacity="0.5"
            Margin="0,12,0,4"
            HorizontalAlignment="Center"
          />
          <TextBlock
            Text="Select a VM and create a snapshot using the panel above."
            Foreground="{DynamicResource MutedBrush}"
            HorizontalAlignment="Center"
            TextAlignment="Center"
          />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
