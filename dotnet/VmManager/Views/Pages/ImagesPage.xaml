<Page
  x:Class="VmManager.Views.Pages.ImagesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  xmlns:models="clr-namespace:VmManager.Models"
  d:DataContext="{d:DesignInstance Type=vm:ImagesViewModel}"
  mc:Ignorable="d"
  Title="Images"
>
  <Grid Margin="24,16,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" MaxHeight="250" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Page header -->
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Marketplace" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
          Text="Browse and import VM images from your registry"
          Foreground="{DynamicResource MutedBrush}"
          FontSize="13"
          Margin="0,4,0,0"
        />
      </StackPanel>

      <Button
        Grid.Column="1"
        Content="↻  Refresh"
        VerticalAlignment="Top"
        Command="{Binding LoadCatalogCommand}"
        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
      />
    </Grid>

    <!-- Status bar -->
    <Border
      Grid.Row="1"
      Background="{Binding IsError, Converter={StaticResource BoolToStatusBrushConverter}}"
      CornerRadius="5"
      Padding="12,8"
      Margin="0,0,0,12"
      Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <DockPanel>
        <Button
          DockPanel.Dock="Right"
          Content="📋"
          ToolTip="Copy to clipboard"
          Click="CopyStatus_Click"
          Background="Transparent"
          Foreground="White"
          Padding="8,4"
          VerticalAlignment="Center"
        />
        <TextBox
          Text="{Binding StatusMessage, Mode=OneWay}"
          IsReadOnly="True"
          Background="Transparent"
          BorderThickness="0"
          Foreground="White"
          TextWrapping="Wrap"
          Padding="0"
          FontSize="13"
          VerticalAlignment="Center"
        />
      </DockPanel>
    </Border>

    <!-- Import progress -->
    <Border
      Grid.Row="2"
      Style="{StaticResource CardStyle}"
      Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding ImportStatusText}" FontWeight="SemiBold" />
          <Button
            Grid.Column="1"
            Content="Cancel"
            Style="{StaticResource DangerButtonStyle}"
            Padding="12,4"
            FontSize="11"
            Command="{Binding CancelImportCommand}"
          />
        </Grid>
        <ProgressBar
          Grid.Row="1"
          Value="{Binding ImportProgress}"
          Minimum="0"
          Maximum="100"
          Height="6"
          Margin="0,0,0,4"
        />
        <TextBlock Grid.Row="2" FontSize="11" Opacity="0.7">
          <Run Text="{Binding ImportProgress, StringFormat={}{0:F0}%, Mode=OneWay}" />
          <Run Text="  " />
          <Run
            Text="{Binding ImportSpeedText, Mode=OneWay}"
            Foreground="{DynamicResource MutedBrush}"
          />
        </TextBlock>
      </Grid>
    </Border>

    <!-- Create-VM busy indicator -->
    <Border
      Grid.Row="2"
      Padding="0,0,0,12"
      Visibility="{Binding IsCreatingVm, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="3" />
        <TextBlock
          Text="{Binding CreateVmStatusMessage}"
          Margin="0,6,0,0"
          FontSize="12"
          Opacity="0.7"
          HorizontalAlignment="Center"
        />
      </StackPanel>
    </Border>

    <!-- Local Images section -->
    <Border
      Grid.Row="3"
      Style="{StaticResource CardStyle}"
      Margin="0,4,0,8"
      Visibility="{Binding HasLocalImages, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <StackPanel>
        <TextBlock Text="Local Images" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding LocalImages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:LocalImage}">
                <Border
                  BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource DividerBrush}"
                  Padding="0,8,0,8"
                >
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          Text="{Binding SizeGb, StringFormat={}{0:F1} GB}"
                          Style="{StaticResource MutedTextStyle}"
                          Margin="0,0,12,0"
                        />
                        <TextBlock
                          Text="{Binding ExtractedAt, StringFormat='Imported {0:yyyy-MM-dd}'}"
                          Style="{StaticResource MutedTextStyle}"
                        />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button
                        Content="➕  Create VM"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,6,0"
                        ToolTip="Create a Hyper-V VM from this local image"
                        Command="{Binding DataContext.CreateVmFromLocalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                      />
                      <Button
                        Content="🗑"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="Delete this local image from disk"
                        Command="{Binding DataContext.DeleteLocalImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"
                      />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Loading indicator -->
    <StackPanel
      Grid.Row="4"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <ProgressBar IsIndeterminate="True" Width="200" Height="4" />
      <TextBlock
        Text="Loading catalog…"
        Margin="0,12,0,0"
        HorizontalAlignment="Center"
        Opacity="0.7"
      />
    </StackPanel>

    <!-- Registry not configured state -->
    <StackPanel
      Grid.Row="4"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Visibility="{Binding RegistryNotConfigured, Converter={StaticResource BoolToVisibilityConverter}}"
    >
      <TextBlock Text="🔗" FontSize="48" Opacity="0.35" HorizontalAlignment="Center" />
      <TextBlock
        Text="No image sources configured"
        FontSize="16"
        Opacity="0.5"
        Margin="0,12,0,4"
        HorizontalAlignment="Center"
      />
      <TextBlock
        Text="Go to Settings to configure an OCI registry and/or a local catalog path."
        Foreground="{DynamicResource MutedBrush}"
        HorizontalAlignment="Center"
        TextAlignment="Center"
      />
    </StackPanel>

    <!-- Images list - card-based layout -->
    <ScrollViewer
      Grid.Row="4"
      VerticalScrollBarVisibility="Auto"
      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}"
    >
      <ItemsControl ItemsSource="{Binding Images}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type models:VmImage}">
            <!-- Image card with accent top border -->
            <Border
              Background="{DynamicResource CardBrush}"
              CornerRadius="8"
              Margin="0,0,0,16"
              Padding="0"
              ClipToBounds="True"
            >
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="4" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Accent top bar -->
                <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" />

                <!-- Header area -->
                <StackPanel Grid.Row="1" Margin="20,16,20,12">
                  <TextBlock
                    Text="{Binding Name}"
                    FontSize="18"
                    FontWeight="Bold"
                    Margin="0,0,0,4"
                  />
                  <TextBlock
                    Text="{Binding Description}"
                    Opacity="0.65"
                    TextWrapping="Wrap"
                    FontSize="13"
                    Margin="0,0,0,10"
                  />

                  <!-- Feature badges -->
                  <ItemsControl ItemsSource="{Binding Features}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border
                          Background="#E8F0FE"
                          CornerRadius="10"
                          Padding="10,4"
                          Margin="0,0,6,4"
                        >
                          <TextBlock Text="{Binding}" FontSize="11" FontWeight="Medium" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Versions list -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Versions}" Margin="0,0,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:VmImageVersion}">
                      <Border
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        Padding="20,12"
                        Background="Transparent"
                      >
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <!-- Version tag -->
                          <Border
                            Grid.Column="0"
                            Background="#F0F0F0"
                            CornerRadius="4"
                            Padding="10,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                          >
                            <TextBlock FontFamily="Consolas" FontSize="13" FontWeight="SemiBold">
                              <Run Text="v" Foreground="#6B6B6B" />
                              <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                          </Border>

                          <!-- Size and date -->
                          <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                          >
                            <TextBlock
                              Text="{Binding SizeGb, StringFormat={}{0:F1} GB}"
                              Opacity="0.6"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                            />
                            <TextBlock
                              Text="{Binding Notes}"
                              Opacity="0.5"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}"
                            />
                          </StackPanel>

                          <!-- Actions -->
                          <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                          >
                            <!-- Import button (not yet local) -->
                            <Button
                              Content="⬇  Import"
                              VerticalAlignment="Center"
                              ToolTip="Download and extract this image to your local disk"
                              Visibility="{Binding IsLocallyAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                              Command="{Binding DataContext.ImportVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding DataContext.IsImporting, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource InverseBoolConverter}}"
                            />

                            <!-- Create VM + re-import (already local) -->
                            <StackPanel
                              Orientation="Horizontal"
                              Visibility="{Binding IsLocallyAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            >
                              <Button
                                Content="➕  Create VM"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center"
                                ToolTip="Spin up a new Hyper-V VM from this image"
                                Command="{Binding DataContext.CreateVmCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                CommandParameter="{Binding}"
                              />
                              <Button
                                Content="↺"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Re-download this version"
                                Command="{Binding DataContext.ImportVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding DataContext.IsImporting, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource InverseBoolConverter}}"
                              />
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Empty state (loaded but no images) -->
    <StackPanel
      Grid.Row="4"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      Visibility="{Binding Images.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"
    >
      <TextBlock Text="📦" FontSize="48" Opacity="0.35" HorizontalAlignment="Center" />
      <TextBlock
        Text="No images found"
        FontSize="16"
        Opacity="0.5"
        Margin="0,12,0,4"
        HorizontalAlignment="Center"
      />
      <TextBlock
        Text="Push box images to your registry using ORAS, then refresh."
        Foreground="{DynamicResource MutedBrush}"
        HorizontalAlignment="Center"
        TextAlignment="Center"
      />
    </StackPanel>
  </Grid>
</Page>
