<UserControl
  x:Class="VmManager.Views.Controls.TaskPanel"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  mc:Ignorable="d"
>
  <Border
    Background="White"
    BorderBrush="{DynamicResource DividerBrush}"
    BorderThickness="1"
    CornerRadius="8"
    Width="380"
    MaxHeight="340"
    BoxShadow="0 4 16 0 #2E000000"
  >
    <DockPanel>
      <!-- Header -->
      <Border
        DockPanel.Dock="Top"
        Padding="14,10,14,8"
        BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="0,0,0,1"
      >
        <DockPanel>
          <TextBlock
            Text="Background Tasks"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextBrush}"
            VerticalAlignment="Center"
          />
          <Button
            DockPanel.Dock="Right"
            Content="Clear completed"
            FontSize="11"
            Padding="8,3"
            HorizontalAlignment="Right"
            Click="ClearCompleted_Click"
          />
        </DockPanel>
      </Border>

      <!-- Task list -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,6,6,6">
        <ItemsControl x:Name="TaskList">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BackgroundTaskViewModel">
              <Border Theme="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,6">
                <StackPanel>
                  <!-- Title row with status icon and cancel button -->
                  <DockPanel>
                    <!-- Status icon -->
                    <Panel
                      DockPanel.Dock="Left"
                      Width="14"
                      Height="14"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                    >
                      <ui:SymbolIcon
                        Symbol="Play"
                        FontSize="14"
                        Foreground="{DynamicResource AccentBrush}"
                        IsVisible="{Binding IsRunning}"
                      />
                      <ui:SymbolIcon
                        Symbol="Checkmark"
                        FontSize="14"
                        Foreground="{DynamicResource SuccessBrush}"
                        IsVisible="{Binding IsComplete}"
                      />
                      <ui:SymbolIcon
                        Symbol="Dismiss"
                        FontSize="14"
                        Foreground="{DynamicResource ErrorBrush}"
                        IsVisible="{Binding IsFailed}"
                      />
                      <ui:SymbolIcon
                        Symbol="Dismiss"
                        FontSize="14"
                        Foreground="{DynamicResource HintBrush}"
                        IsVisible="{Binding IsCancelled}"
                      />
                    </Panel>

                    <!-- Cancel button -->
                    <Button
                      DockPanel.Dock="Right"
                      Padding="4,2"
                      ToolTip.Tip="Cancel"
                      Command="{Binding CancelCommand}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowCancelButton}"
                    >
                      <ui:SymbolIcon Symbol="Dismiss" FontSize="11" />
                    </Button>

                    <!-- Title -->
                    <TextBlock
                      Text="{Binding Title}"
                      FontWeight="SemiBold"
                      FontSize="12"
                      Foreground="{DynamicResource TextBrush}"
                      TextTrimming="CharacterEllipsis"
                      VerticalAlignment="Center"
                    />
                  </DockPanel>

                  <!-- Status text -->
                  <Panel Margin="22,2,0,0">
                    <TextBlock
                      Text="{Binding Status}"
                      FontSize="11"
                      Foreground="{DynamicResource MutedBrush}"
                      TextTrimming="CharacterEllipsis"
                      IsVisible="{Binding !IsCancelled}"
                    />
                    <TextBlock
                      Text="{Binding Status}"
                      FontSize="11"
                      Foreground="{DynamicResource HintBrush}"
                      TextTrimming="CharacterEllipsis"
                      IsVisible="{Binding IsCancelled}"
                    />
                  </Panel>

                  <!-- Progress bar -->
                  <ProgressBar
                    Margin="22,4,0,0"
                    Height="3"
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding Progress, Mode=OneWay}"
                    IsVisible="{Binding ShowProgressBar}"
                  />

                  <!-- Error message -->
                  <TextBlock
                    Text="{Binding ErrorMessage}"
                    FontSize="11"
                    Foreground="{DynamicResource ErrorBrush}"
                    Margin="22,2,0,0"
                    TextWrapping="Wrap"
                    IsVisible="{Binding ShowError}"
                  />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
