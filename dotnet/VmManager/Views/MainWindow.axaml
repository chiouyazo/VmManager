<Window
  x:Class="VmManager.Views.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:props="clr-namespace:VmManager.Properties"
  xmlns:ui="using:FluentAvalonia.UI.Controls"
  xmlns:vm="clr-namespace:VmManager.ViewModels"
  Title="{x:Static props:Resources.AppTitle}"
  Width="1100"
  Height="720"
  MinWidth="860"
  MinHeight="560"
  Background="{DynamicResource BgBrush}"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Grid ColumnDefinitions="56,*">

    <!-- Narrow icon sidebar -->
    <Border
      Grid.Column="0"
      Background="{DynamicResource SurfaceBrush}"
      BorderBrush="{DynamicResource DividerBrush}"
      BorderThickness="0,0,1,0"
    >
      <DockPanel>
        <!-- App icon top -->
        <Border DockPanel.Dock="Top" Padding="0,14,0,10" HorizontalAlignment="Center">
          <Image Source="../Assets/app_32.png" Width="28" Height="28" />
        </Border>

        <!-- spacer where env selector used to be -->
        <Border DockPanel.Dock="Top" Height="4" />

        <!-- Bottom nav items -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="2" Margin="0,0,0,12">
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="10,4,10,6" />
          <Button
            x:Name="NavSettings"
            Tag="Settings"
            Click="NavItem_Click"
            Background="Transparent"
            BorderThickness="0"
            Width="40" Height="40"
            Padding="0"
            HorizontalAlignment="Center"
            ToolTip.Tip="{x:Static props:Resources.Nav_Settings}"
            Cursor="Hand"
          >
            <ui:SymbolIcon Symbol="Settings" FontSize="20" Foreground="{DynamicResource MutedBrush}" />
          </Button>
        </StackPanel>

        <!-- Main nav items -->
        <StackPanel VerticalAlignment="Top" Spacing="2" Margin="0,4,0,0">
          <Button
            x:Name="NavImages"
            Tag="Images"
            Click="NavItem_Click"
            Background="Transparent"
            BorderThickness="0"
            Width="40" Height="40"
            Padding="0"
            HorizontalAlignment="Center"
            ToolTip.Tip="{x:Static props:Resources.Nav_Marketplace}"
            Cursor="Hand"
          >
            <ui:SymbolIcon Symbol="Shop" FontSize="20" Foreground="{DynamicResource MutedBrush}" />
          </Button>
          <Button
            x:Name="NavMyVMs"
            Tag="MyVMs"
            Click="NavItem_Click"
            Background="Transparent"
            BorderThickness="0"
            Width="40" Height="40"
            Padding="0"
            HorizontalAlignment="Center"
            ToolTip.Tip="{x:Static props:Resources.Nav_MyVms}"
            Cursor="Hand"
          >
            <ui:SymbolIcon Symbol="List" FontSize="20" Foreground="{DynamicResource MutedBrush}" />
          </Button>
          <Button
            x:Name="NavSessions"
            Tag="Sessions"
            Click="NavItem_Click"
            Background="Transparent"
            BorderThickness="0"
            Width="40" Height="40"
            Padding="0"
            HorizontalAlignment="Center"
            IsVisible="False"
            ToolTip.Tip="Sessions"
            Cursor="Hand"
          >
            <ui:SymbolIcon Symbol="People" FontSize="20" Foreground="{DynamicResource MutedBrush}" />
          </Button>
          <Button
            x:Name="NavUsers"
            Tag="Users"
            Click="NavItem_Click"
            Background="Transparent"
            BorderThickness="0"
            Width="40" Height="40"
            Padding="0"
            HorizontalAlignment="Center"
            IsVisible="False"
            ToolTip.Tip="Users"
            Cursor="Hand"
          >
            <ui:SymbolIcon Symbol="People" FontSize="20" Foreground="{DynamicResource MutedBrush}" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main content area -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">

      <!-- Page content -->
      <ContentControl x:Name="ContentArea" Grid.Row="0" />

      <!-- Status bar -->
      <Border
        x:Name="StatusBarArea"
        x:DataType="vm:MainWindowViewModel"
        Grid.Row="1"
        Background="{DynamicResource BgBrush}"
        BorderBrush="{DynamicResource DividerBrush}"
        BorderThickness="0,1,0,0"
        Padding="20,5"
      >
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Right"
            Text="{Binding VersionText}"
            FontSize="11"
            Foreground="{DynamicResource HintBrush}"
            VerticalAlignment="Center"
            Cursor="Hand"
            PointerPressed="VersionText_Click"
            ToolTip.Tip="{x:Static props:Resources.Tooltip_OpenGitHub}"
          />

          <Button
            x:Name="TaskIndicatorButton"
            DockPanel.Dock="Right"
            Click="TaskIndicator_Click"
            VerticalAlignment="Center"
            Margin="12,0,0,0"
            Padding="8,3"
            Cursor="Hand"
            ToolTip.Tip="Background tasks"
            IsVisible="{Binding HasTasks}"
            Background="Transparent"
            BorderThickness="0"
          >
            <StackPanel Orientation="Horizontal" Spacing="5">
              <ui:SymbolIcon Symbol="Download" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding TaskStatusDisplayText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="16">
            <Button
              Background="Transparent"
              BorderThickness="0"
              Padding="0"
              Cursor="Hand"
              VerticalAlignment="Center"
            >
              <StackPanel Orientation="Horizontal" Spacing="5">
                <ui:SymbolIcon Symbol="Globe" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock x:Name="EnvironmentLabel" Text="Local" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                  <StackPanel Spacing="8" MinWidth="240">
                    <TextBlock Text="Switch Environment" FontSize="13" FontWeight="SemiBold" />
                    <ComboBox
                      x:Name="EnvironmentSelector"
                      FontSize="12"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="EnvironmentSelector_Changed"
                    />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Border Width="1" Height="12" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />

            <StackPanel
              Orientation="Horizontal" Spacing="6"
              Cursor="Hand"
              PointerPressed="FeedStatus_Click"
              ToolTip.Tip="{x:Static props:Resources.Tooltip_GoToImageSources}"
            >
              <Ellipse Width="7" Height="7" Fill="{DynamicResource StateRunningBrush}" IsVisible="{Binding FeedIndicatorActive}" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource HintBrush}" IsVisible="{Binding !FeedIndicatorActive}" />
              <TextBlock Text="{Binding FeedStatusText}" FontSize="11" Foreground="{DynamicResource HintBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource StateRunningBrush}" IsVisible="{Binding BackendAvailable}" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource ErrorBrush}" IsVisible="{Binding !BackendAvailable}" />
              <TextBlock Text="{Binding BackendStatusText}" FontSize="11" Foreground="{DynamicResource HintBrush}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Notifications -->
      <WindowNotificationManager
        x:Name="NotificationManager"
        Grid.Row="0"
        Position="BottomRight"
        MaxItems="3"
        Margin="0,0,16,40"
      />

      <!-- Task panel popup -->
      <Popup
        x:Name="TaskPanelPopup"
        Placement="Top"
        PlacementTarget="{Binding ElementName=TaskIndicatorButton}"
        IsLightDismissEnabled="True"
        HorizontalOffset="-300"
        VerticalOffset="-4"
      >
        <ContentControl x:Name="TaskPanelHost" />
      </Popup>
    </Grid>
  </Grid>
</Window>
