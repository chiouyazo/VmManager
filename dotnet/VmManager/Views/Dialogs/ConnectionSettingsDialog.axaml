<Window
  x:Class="VmManager.Views.Dialogs.ConnectionSettingsDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="Connection Settings"
  Width="400"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
  KeyDown="Window_KeyDown"
  mc:Ignorable="d"
>
  <StackPanel Margin="16,14,16,16">

    <TextBlock x:Name="HeaderText" Text="Connect to VM" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,6">
      <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,0,6" />
      <ComboBox x:Name="DisplayModeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="1" Margin="0,0,0,6">
        <ComboBoxItem Content="Windowed" />
        <ComboBoxItem Content="Fullscreen" />
      </ComboBox>

      <TextBlock Grid.Row="1" Text="Resolution" VerticalAlignment="Center" Margin="0,0,0,6" />
      <ComboBox x:Name="ResolutionBox" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,6" />

      <TextBlock Grid.Row="2" Text="Sound" VerticalAlignment="Center" Margin="0,0,0,6" />
      <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
        <RadioButton x:Name="AudioLocal" Content="Local" GroupName="Audio" IsChecked="True" />
        <RadioButton x:Name="AudioRemote" Content="Remote" GroupName="Audio" />
        <RadioButton x:Name="AudioOff" Content="Off" GroupName="Audio" />
      </StackPanel>
    </Grid>

    <WrapPanel Margin="0,0,0,8">
      <CheckBox x:Name="ClipboardBox" Content="Clipboard" IsChecked="True" Margin="0,0,14,0" />
      <CheckBox x:Name="MultiMonBox" Content="Multi-monitor" />
    </WrapPanel>

    <Button x:Name="AdvancedToggle" Click="AdvancedToggle_Click"
            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" Cursor="Hand">
      <TextBlock x:Name="AdvancedToggleText" Text="&#x25B8; Advanced" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
    </Button>
    <StackPanel x:Name="AdvancedPanel" IsVisible="False" Margin="0,0,0,8" Spacing="6">
      <Grid ColumnDefinitions="110,*">
        <TextBlock Text="Color depth" VerticalAlignment="Center" />
        <ComboBox x:Name="ColorDepthBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="2">
          <ComboBoxItem Content="16-bit" Tag="16" />
          <ComboBoxItem Content="24-bit" Tag="24" />
          <ComboBoxItem Content="32-bit" Tag="32" />
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="110,*">
        <TextBlock Text="Drives" VerticalAlignment="Center" />
        <ComboBox x:Name="DrivesBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0">
          <ComboBoxItem Content="None" Tag="" />
          <ComboBoxItem Content="All drives" Tag="*" />
          <ComboBoxItem Content="Hotplugged only" Tag="DynamicDrives" />
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="110,*">
        <TextBlock Text="Keyboard" VerticalAlignment="Center" />
        <ComboBox x:Name="KeyboardHookBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="2">
          <ComboBoxItem Content="Local only" />
          <ComboBoxItem Content="Remote always" />
          <ComboBoxItem Content="Fullscreen only" />
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="110,*">
        <TextBlock Text="Network" VerticalAlignment="Center" />
        <ComboBox x:Name="NetworkHintBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="6">
          <ComboBoxItem Content="Modem (56 Kbps)" />
          <ComboBoxItem Content="Low broadband" />
          <ComboBoxItem Content="Satellite" />
          <ComboBoxItem Content="High broadband" />
          <ComboBoxItem Content="WAN" />
          <ComboBoxItem Content="LAN" />
          <ComboBoxItem Content="Auto-detect" />
        </ComboBox>
      </Grid>
      <WrapPanel>
        <CheckBox x:Name="SmartSizingBox" Content="Smart sizing" Margin="0,0,14,0" />
        <CheckBox x:Name="DynamicResizeBox" Content="Dynamic resize" IsChecked="True" Margin="0,0,14,0" />
        <CheckBox x:Name="MicrophoneBox" Content="Microphone" Margin="0,0,14,0" />
        <CheckBox x:Name="PrintersBox" Content="Printers" Margin="0,0,14,0" />
        <CheckBox x:Name="FontSmoothingBox" Content="Font smoothing" IsChecked="True" Margin="0,0,14,0" />
        <CheckBox x:Name="WallpaperBox" Content="Wallpaper" IsChecked="True" Margin="0,0,14,0" />
        <CheckBox x:Name="WebcamBox" Content="Webcam" Margin="0,0,14,0" />
        <CheckBox x:Name="UsbBox" Content="USB devices" />
      </WrapPanel>
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <CheckBox x:Name="RememberBox" Content="Remember as default" Margin="0,0,8,0" VerticalAlignment="Center" />
      <Button Content="Cancel" Click="Cancel_Click" Padding="12,6" />
      <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Theme="{StaticResource FilledAccentButton}" Padding="12,6" />
    </StackPanel>

  </StackPanel>
</Window>
