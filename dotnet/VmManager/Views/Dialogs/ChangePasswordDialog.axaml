<Window
  x:Class="VmManager.Views.Dialogs.ChangePasswordDialog"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Password Change Required"
  Width="400"
  SizeToContent="Height"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource BgBrush}"
  ShowInTaskbar="False"
>
  <StackPanel Margin="24">
    <TextBlock
      Text="You must change your password before continuing."
      TextWrapping="Wrap"
      Foreground="{DynamicResource TextBrush}"
      FontSize="14"
      Margin="0,0,0,16"
    />

    <TextBlock Text="New Password" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}" />
    <TextBox
      x:Name="PasswordBox"
      PasswordChar="*"
      Margin="0,0,0,12"
      KeyDown="PasswordBox_KeyDown"
    />

    <TextBlock Text="Confirm Password" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}" />
    <TextBox
      x:Name="ConfirmBox"
      PasswordChar="*"
      Margin="0,0,0,8"
      KeyDown="PasswordBox_KeyDown"
    />

    <TextBlock
      x:Name="ErrorText"
      Foreground="{DynamicResource ErrorBrush}"
      FontSize="12"
      Margin="0,0,0,12"
      IsVisible="False"
      TextWrapping="Wrap"
    />

    <Button
      x:Name="ChangeButton"
      Content="Change Password"
      Theme="{StaticResource FilledAccentButton}"
      HorizontalAlignment="Stretch"
      Click="Change_Click"
      Padding="12,10"
    />
  </StackPanel>
</Window>
