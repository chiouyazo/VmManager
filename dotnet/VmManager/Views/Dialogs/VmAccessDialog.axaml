<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:VmManager.Views.Dialogs"
  x:Class="VmManager.Views.Dialogs.VmAccessDialog"
  x:DataType="local:VmAccessDialog"
  mc:Ignorable="d"
  Title="Manage VM Access"
  Width="450"
  MinHeight="300"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner"
  CanResize="False"
>
  <StackPanel Margin="20">
    <TextBlock Text="{Binding VmName}" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
    <TextBlock FontSize="12" Opacity="0.6" Margin="0,0,0,16">
      <Run Text="Owner: " />
      <Run Text="{Binding OwnerName}" FontWeight="SemiBold" />
    </TextBlock>

    <TextBlock Text="Access Grants" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />

    <ItemsControl ItemsSource="{Binding Grants}" Margin="0,0,0,12">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="local:GrantItem">
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Username}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" SelectedItem="{Binding Permission}" ItemsSource="{Binding $parent[Window].((local:VmAccessDialog)DataContext).PermissionOptions}" Margin="4,0" />
            <Button Grid.Column="2" Content="Remove" Click="RemoveGrant_Click" Tag="{Binding}" Padding="8,4" FontSize="11" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" Watermark="Username" x:Name="NewUsernameBox" />
      <ComboBox Grid.Column="1" x:Name="NewPermissionBox" SelectedIndex="0" Margin="4,0" />
      <Button Grid.Column="2" Content="Add" Click="AddGrant_Click" Padding="12,6" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Save" Click="Save_Click" Classes="accent" Padding="20,8" />
      <Button Content="Cancel" Click="Cancel_Click" Padding="20,8" />
    </StackPanel>
  </StackPanel>
</Window>
