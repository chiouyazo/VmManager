<Window
  x:Class="VmManager.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  Title="VM Manager"
  Width="1100"
  Height="720"
  MinWidth="860"
  MinHeight="560"
  Background="{DynamicResource SurfaceBrush}"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ── Navigation rail (left sidebar) ─────────────────────────── -->
    <Border
      Grid.Row="0"
      Grid.Column="0"
      Grid.RowSpan="2"
      Background="{DynamicResource SidebarBrush}"
      BorderBrush="{DynamicResource DividerBrush}"
      BorderThickness="0,0,1,0"
    >
      <DockPanel>
        <!-- App title -->
        <Border DockPanel.Dock="Top" Padding="20,22,20,18">
          <StackPanel>
            <TextBlock
              Text="VM Manager"
              FontSize="17"
              FontWeight="Bold"
              Foreground="{DynamicResource TextBrush}"
            />
            <TextBlock
              Text="Hyper-V + Docker"
              FontSize="11"
              Foreground="{DynamicResource AccentBrush}"
              Margin="0,2,0,0"
            />
          </StackPanel>
        </Border>

        <!-- Divider -->
        <Border
          DockPanel.Dock="Top"
          Height="1"
          Background="{DynamicResource DividerBrush}"
          Margin="16,0,16,12"
        />

        <!-- Settings at the bottom -->
        <Border DockPanel.Dock="Bottom" Padding="10,8,10,14">
          <Button
            x:Name="NavSettings"
            Tag="Settings"
            Style="{StaticResource NavButtonStyle}"
            Click="NavItem_Click"
          >
            <StackPanel Orientation="Horizontal">
              <TextBlock
                Text="&#xE713;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="16"
                VerticalAlignment="Center"
              />
              <TextBlock
                Text="Settings"
                FontSize="13"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </Button>
        </Border>

        <Border
          DockPanel.Dock="Bottom"
          Height="1"
          Background="{DynamicResource DividerBrush}"
          Margin="16,0,16,8"
        />

        <!-- Main nav items -->
        <StackPanel Margin="10,0,10,0">
          <Button
            x:Name="NavImages"
            Tag="Images"
            Style="{StaticResource NavButtonActiveStyle}"
            Click="NavItem_Click"
          >
            <StackPanel Orientation="Horizontal">
              <TextBlock
                Text="&#xE8B9;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="16"
                VerticalAlignment="Center"
              />
              <TextBlock
                Text="Marketplace"
                FontSize="13"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </Button>
          <Button
            x:Name="NavMyVMs"
            Tag="MyVMs"
            Style="{StaticResource NavButtonStyle}"
            Click="NavItem_Click"
          >
            <StackPanel Orientation="Horizontal">
              <TextBlock
                Text="&#xE7F4;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="16"
                VerticalAlignment="Center"
              />
              <TextBlock Text="My VMs" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button
            x:Name="NavSnapshots"
            Tag="Snapshots"
            Style="{StaticResource NavButtonStyle}"
            Click="NavItem_Click"
          >
            <StackPanel Orientation="Horizontal">
              <TextBlock
                Text="&#xE787;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="16"
                VerticalAlignment="Center"
              />
              <TextBlock
                Text="Snapshots"
                FontSize="13"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Content frame ─────────────────────────────────────────── -->
    <Frame x:Name="ContentFrame" Grid.Row="0" Grid.Column="1" NavigationUIVisibility="Hidden" />

    <!-- ── Status bar (bottom) ───────────────────────────────────── -->
    <Border
      Grid.Row="1"
      Grid.Column="1"
      Background="{DynamicResource SurfaceBrush}"
      BorderBrush="{DynamicResource DividerBrush}"
      BorderThickness="0,1,0,0"
      Padding="16,6,16,6"
    >
      <DockPanel>
        <!-- Right: version link -->
        <TextBlock
          DockPanel.Dock="Right"
          x:Name="VersionText"
          Text="VM Manager v1.2.0"
          FontSize="11"
          Foreground="{DynamicResource AccentBrush}"
          VerticalAlignment="Center"
          Cursor="Hand"
          MouseLeftButtonUp="VersionText_Click"
          ToolTip="Open project on GitHub"
        >
          <TextBlock.TextDecorations>
            <TextDecoration Location="Underline" />
          </TextBlock.TextDecorations>
        </TextBlock>

        <!-- Left: statuses -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <!-- Connection status -->
          <StackPanel
            x:Name="ConnectionStatusPanel"
            Orientation="Horizontal"
            Margin="0,0,20,0"
            Visibility="Collapsed"
          >
            <Ellipse
              x:Name="ConnectionIndicator"
              Width="8"
              Height="8"
              Margin="0,0,6,0"
              Fill="Gray"
            />
            <TextBlock
              x:Name="ConnectionStatusText"
              Text="Registry: Not configured"
              FontSize="11"
              Foreground="{DynamicResource MutedBrush}"
              VerticalAlignment="Center"
            />
          </StackPanel>

          <!-- Hyper-V status -->
          <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
            <Ellipse x:Name="HyperVIndicator" Width="8" Height="8" Margin="0,0,6,0" Fill="Gray" />
            <TextBlock
              x:Name="HyperVStatusText"
              Text="Hyper-V: Wird geprüft…"
              FontSize="11"
              Foreground="{DynamicResource MutedBrush}"
              VerticalAlignment="Center"
            />
          </StackPanel>

          <!-- Docker status -->
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="DockerIndicator" Width="8" Height="8" Margin="0,0,6,0" Fill="Gray" />
            <TextBlock
              x:Name="DockerStatusText"
              Text="Docker: Wird geprüft…"
              FontSize="11"
              Foreground="{DynamicResource MutedBrush}"
              VerticalAlignment="Center"
            />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
